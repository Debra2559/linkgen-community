/* app.wxss - 花园水彩主题：清透绿、纸张白、花瓣粉 */
page {
  --brand: #3f7c68;
  --brand-deep: #245548;
  --brand-grad: #3f7c68;
  --brand-light: #e7f2eb;
  --bg: #f4f6ef;
  --card: #fffefa;
  --text-main: #20352f;
  --text-sub: #788b83;
  --line: #dce8df;
  --blush: #e99786;
  --sky: #dcebf0;
  --paper: rgba(255, 254, 250, 0.88);
  --shadow-card: 0 12rpx 34rpx rgba(42, 79, 65, 0.1);
  --shadow-brand: 0 10rpx 22rpx rgba(47, 103, 83, 0.24);
  --font-display: 'Kaiti SC', 'STKaiti', 'Hiragino Mincho ProN', 'Songti SC', serif;
  --font-ui: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;

  background: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: var(--font-ui);
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: 1.5;
  font-size: inherit;
}
button::after {
  border: none;
}

.card {
  background: var(--card);
  border-radius: 18rpx;
  box-shadow: var(--shadow-card);
}

.price-text {
  color: var(--brand);
  font-weight: 700;
}

.tag-status-pending {
  color: #e8930c;
  background: #fdf3e0;
}
.tag-status-done {
  color: #39745b;
  background: #e5f1e8;
}
