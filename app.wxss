/* LinkGen community theme: warm coral accents on a deep ink base. */
page {
  --ink: #161310;
  --ink-soft: #5b5046;
  --coral: #ff713b;
  --coral-soft: #fff0e3;
  --mint: #e9edc9;
  --yellow: #ffd95c;
  --sky: #e8eff4;
  --bg: #fffaf1;
  --card: #fffef9;
  --text: #201b16;
  --muted: #8f8275;
  --line: #eee3d3;
  --shadow: 0 14rpx 36rpx rgba(84, 56, 22, 0.09);
  --font-ui: 'Avenir Next', 'SF Pro Rounded', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
  --font-display: 'Avenir Next', 'SF Pro Rounded', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: var(--font-ui);
}

view, text, scroll-view, button, input, textarea, picker { box-sizing: border-box; }
button { margin: 0; padding: 0; background: none; border: 0; line-height: 1.5; font-size: inherit; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 0 32rpx 44rpx; background: var(--bg); }
.card { background: var(--card); border-radius: 26rpx; box-shadow: var(--shadow); }
.muted { color: var(--muted); }
.accent { color: var(--coral); }
.pill { display: inline-flex; align-items: center; padding: 7rpx 16rpx; border-radius: 999rpx; background: var(--coral-soft); color: var(--coral); font-size: 21rpx; }
.tag { display: inline-block; margin: 0 10rpx 10rpx 0; padding: 7rpx 14rpx; color: var(--ink-soft); background: #eef4ef; border-radius: 9rpx; font-size: 21rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 42rpx 0 28rpx; }
.brand-lockup { display: flex; align-items: center; }
.brand-dot { width: 44rpx; height: 44rpx; margin-right: 14rpx; border-radius: 14rpx; background: var(--coral); color: #fff; font-size: 27rpx; font-weight: 800; text-align: center; line-height: 44rpx; transform: rotate(-8deg); }
.brand-name { color: var(--ink); font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; }
.brand-sub { margin-left: 12rpx; color: var(--muted); font-size: 20rpx; }
.icon-button { display: flex; align-items: center; justify-content: center; width: 72rpx; min-width: 72rpx; max-width: 72rpx; height: 72rpx; padding: 0; overflow: hidden; border: 0; border-radius: 50%; background: #fff; color: var(--ink); font-size: 32rpx; text-align: center; line-height: 1; box-shadow: 0 6rpx 20rpx rgba(22, 48, 41, 0.08); }
.search-box { display: flex; align-items: center; height: 78rpx; padding: 0 22rpx; margin-bottom: 26rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: #fff; color: var(--muted); }
.search-icon { margin-right: 12rpx; font-size: 28rpx; }
.search-input { flex: 1; min-width: 0; color: var(--text); font-size: 25rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 32rpx 0 18rpx; }
.section-title { color: var(--ink); font-family: var(--font-display); font-size: 38rpx; font-weight: 800; letter-spacing: 0; }
.section-caption { color: var(--muted); font-size: 22rpx; }
.empty { padding: 120rpx 0; color: var(--muted); text-align: center; }
.primary-button { display: flex; align-items: center; justify-content: center; height: 84rpx; padding: 0 30rpx; border-radius: 18rpx; background: var(--ink); color: #fff; font-size: 27rpx; font-weight: 700; }
.secondary-button { display: flex; align-items: center; justify-content: center; height: 78rpx; padding: 0 24rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; color: var(--ink); font-size: 26rpx; font-weight: 700; }
.fab { position: fixed; right: 28rpx; bottom: 140rpx; z-index: 5; display: flex; align-items: center; justify-content: center; width: 92rpx !important; min-width: 92rpx; max-width: 92rpx; height: 92rpx; min-height: 92rpx; padding: 0; border-radius: 30rpx; background: var(--coral); color: #fff; font-size: 34rpx; line-height: 1; box-shadow: 0 14rpx 28rpx rgba(243, 107, 79, 0.3); }
.avatar { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 24rpx; color: #fff; font-size: 27rpx; font-weight: 800; }
.small-avatar { width: 58rpx; height: 58rpx; border-radius: 18rpx; font-size: 21rpx; }
.divider { height: 1rpx; background: var(--line); }
.safe-bottom { height: 32rpx; }

/* Dark mode is opt-in. The light palette above remains the owner-approved default. */
.theme-dark {
  --ink: #f5f7ff;
  --ink-soft: #c8d0e6;
  --coral: #9b7bff;
  --coral-soft: rgba(155, 123, 255, .16);
  --mint: #173248;
  --yellow: #58d8ff;
  --sky: #10253d;
  --bg: #050816;
  --card: #0d1428;
  --text: #f5f7ff;
  --muted: #8d9ab8;
  --line: #202b46;
  --shadow: 0 14rpx 36rpx rgba(0, 0, 0, .28);
  --surface-raised: #131d36;
  --surface-input: #0a1122;
  --action-bg: #7f5af0;
  --action-text: #ffffff;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}

.theme-dark .card,
.theme-dark .menu-list,
.theme-dark .search-box,
.theme-dark .topic-chip,
.theme-dark .category-chip,
.theme-dark .secondary-button,
.theme-dark .icon-button,
.theme-dark .detail-attachment,
.theme-dark .info-list,
.theme-dark .link-preview,
.theme-dark .sheet-secondary,
.theme-dark .source-button,
.theme-dark .bio-panel,
.theme-dark .organizer-bio,
.theme-dark .profile-preview-card,
.theme-dark .preview-card,
.theme-dark .review-card,
.theme-dark .agent-source-row,
.theme-dark .activity-tabs,
.theme-dark .activity-tab.active,
.theme-dark .month-cell,
.theme-dark .field-input,
.theme-dark .field-textarea,
.theme-dark .field-picker,
.theme-dark .line-input,
.theme-dark .line-textarea,
.theme-dark .detail-input,
.theme-dark .custom-input,
.theme-dark .count-stepper,
.theme-dark .type-symbol,
.theme-dark .cover-upload-mark,
.theme-dark .save-button {
  background: var(--surface-raised);
  color: var(--ink);
  border-color: var(--line);
}

.theme-dark .page,
.theme-dark .search-box,
.theme-dark .field-input,
.theme-dark .field-textarea,
.theme-dark .field-picker,
.theme-dark .line-input,
.theme-dark .line-textarea,
.theme-dark .detail-input,
.theme-dark .custom-input {
  background: var(--bg);
  color: var(--text);
}

.theme-dark .search-box,
.theme-dark .field-input,
.theme-dark .field-textarea,
.theme-dark .field-picker,
.theme-dark .line-input,
.theme-dark .line-textarea,
.theme-dark .detail-input,
.theme-dark .custom-input,
.theme-dark .count-stepper,
.theme-dark .type-option,
.theme-dark .venue-option,
.theme-dark .category-chip,
.theme-dark .topic-chip,
.theme-dark .choice,
.theme-dark .admin-tab {
  background: var(--surface-input);
  border-color: var(--line);
  color: var(--ink-soft);
}

.theme-dark .tag,
.theme-dark .mini-tag,
.theme-dark .resource-tag,
.theme-dark .post-tags .tag {
  background: var(--surface-raised);
  color: var(--ink-soft);
}

.theme-dark .primary-button,
.theme-dark .submit-button,
.theme-dark .continue-edit-button,
.theme-dark .send-button,
.theme-dark .sheet-primary,
.theme-dark .ai-button,
.theme-dark .agent-run-button,
.theme-dark .open-button {
  background: var(--action-bg);
  color: var(--action-text);
}

.theme-dark .type-option.selected,
.theme-dark .venue-option.selected,
.theme-dark .choice.chosen,
.theme-dark .topic-chip.selected,
.theme-dark .category-chip.selected,
.theme-dark .calendar-mode.active,
.theme-dark .view-tab.active,
.theme-dark .admin-tab.active {
  border-color: var(--coral);
  background: var(--coral);
  color: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(181, 156, 255, .22);
}

.theme-dark .month-cell.empty-cell { background: rgba(19, 29, 54, .55); }
.theme-dark .comment-bar { background: rgba(5, 8, 22, .97); }
.theme-dark .send-button[disabled],
.theme-dark button[disabled],
.theme-dark .upload-button { background: var(--surface-raised); color: var(--muted); opacity: .7; }
.theme-dark .profile-card { background: linear-gradient(135deg, #111a35, #172a4b); }

.theme-dark .choice:active,
.theme-dark .topic-chip:active,
.theme-dark .category-chip:active,
.theme-dark .theme-switch:active { opacity: .76; transform: scale(.98); }
