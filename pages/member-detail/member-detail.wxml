<view class="page member-detail-page {{themeMode === 'light' ? 'theme-light' : ''}}" wx:if="{{member}}">
  <view class="member-cover" style="background: {{member.color}}"><view class="cover-grid"></view><view class="cover-mark">LINKGEN / MEMBER CARD</view><view class="avatar member-avatar"><image wx:if="{{member.avatar}}" class="avatar-image" src="{{member.avatar}}" mode="aspectFill"/><text wx:if="{{!member.avatar}}">{{member.initials}}</text></view></view>
  <view class="member-heading"><view><text class="member-detail-name">{{member.name}}</text><text class="member-detail-role">{{member.role}}<text wx:if="{{member.city}}"> · {{member.city}}</text></text></view><view wx:if="{{member.online}}" class="member-online"><view class="online-dot"></view>在线</view></view>
  <view class="member-detail-tags"><text wx:for="{{member.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
  <view class="member-signal"><text class="signal-label">CURRENT SIGNAL</text><text class="signal-text">正在寻找：{{member.purpose}}</text></view>
  <view class="bio-panel"><view class="panel-heading"><text class="panel-label">ABOUT {{member.name}}</text><text class="panel-index">01</text></view><text class="panel-text">{{member.bio}}</text></view>
  <view class="detail-metrics"><view><text class="metric-number">12</text><text class="metric-label">公开动态</text></view><view><text class="metric-number">06</text><text class="metric-label">参加活动</text></view><view><text class="metric-number">∞</text><text class="metric-label">可连接</text></view></view>
  <view class="contact-actions"><button class="primary-button" bindtap="connect">交换微信</button><button class="secondary-button" bindtap="sendMessage">发消息</button></view>
</view><view wx:else class="empty detail-empty">成员名片不存在</view>
