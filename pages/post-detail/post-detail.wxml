<view class="page detail-page {{themeMode === 'light' ? 'theme-light' : ''}}" wx:if="{{post}}">
  <view class="detail-kicker"><text>LINKGEN / {{post.contentTypeLabel}}</text><text wx:if="{{post.hot}}" class="detail-hot">HOT</text></view>

  <view class="detail-content-panel">
    <view class="detail-author">
      <view class="avatar detail-avatar" style="background: {{post.color}}"><image wx:if="{{post.avatar}}" class="avatar-image" src="{{post.avatar}}" mode="aspectFill"/><text wx:if="{{!post.avatar}}">{{post.initials}}</text></view>
      <view class="author-meta">
        <view class="author-name-row"><text class="author-name">{{post.author}}</text><text class="author-mark">成员</text></view>
        <text class="author-role">{{post.role}}</text>
      </view>
      <text class="detail-time">{{post.time}}</text>
    </view>

    <text class="detail-title">{{post.title}}</text>
    <text class="detail-content">{{post.content}}</text>
    <view wx:if="{{post.attachments && post.attachments.length}}" class="detail-attachments"><view wx:for="{{post.attachments}}" wx:key="id" class="detail-attachment"><image wx:if="{{item.type === 'image'}}" class="detail-attachment-image" src="{{item.path}}" mode="aspectFill" /><video wx:elif="{{item.type === 'video'}}" class="detail-attachment-video" src="{{item.path}}" controls show-center-play-btn object-fit="contain" /><view wx:else class="detail-attachment-link" bindtap="copyAttachmentLink" data-url="{{item.url}}"><text class="detail-link-mark">↗</text><view class="detail-link-copy"><text class="detail-link-name">{{item.name}}</text><text class="detail-link-url">{{item.url}}</text><text class="detail-link-action">点击复制链接</text></view></view></view></view>
    <view class="post-tags"><text wx:for="{{post.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>

    <view class="detail-actions">
      <button class="action-button like-action {{post.liked ? 'liked' : ''}}" bindtap="toggleLike"><text class="action-icon">{{post.liked ? '♥' : '♡'}}</text><text>{{post.likes}}</text><text class="action-label">个赞</text></button>
      <view class="action-divider"></view>
      <view class="action-button reply-action"><text class="action-icon reply-icon">◌</text><text>{{post.comments}}</text><text class="action-label">条回复</text></view>
    </view>
    <view wx:if="{{post.contentType === 'task'}}" class="task-detail-panel"><view class="task-detail-head"><text class="task-kind">{{post.taskKindLabel}}</text><text class="task-status task-status-{{post.taskStatus}}">{{post.taskStatusLabel}}</text></view><view wx:if="{{post.linkedEventTitle}}" class="task-detail-line"><text>关联活动</text><text>{{post.linkedEventTitle}}</text></view><view class="task-detail-line"><text>参与进度</text><text>{{post.participantCount}} / {{post.neededPeople}} 人</text></view><view wx:if="{{post.deadline}}" class="task-detail-line"><text>截止日期</text><text>{{post.deadline}}</text></view><view class="task-buttons"><button bindtap="taskAction" data-action="interest">{{post.interestedCount}} 人感兴趣</button><button disabled="{{!post.isParticipating && post.participantCount >= post.neededPeople}}" bindtap="taskAction" data-action="join">{{post.isParticipating ? '退出任务' : (post.participantCount >= post.neededPeople ? '人数已满' : '我想加入')}}</button></view><view wx:if="{{post.canAdvance}}" class="task-advance"><button wx:if="{{post.taskStatus === 'recruiting'}}" bindtap="advanceTask" data-status="in_progress">开始执行</button><button wx:if="{{post.taskStatus === 'in_progress'}}" bindtap="advanceTask" data-status="completed">标记完成</button><button wx:if="{{post.taskStatus === 'recruiting' || post.taskStatus === 'in_progress'}}" bindtap="advanceTask" data-status="cancelled">取消任务</button></view></view>
  </view>

  <view class="section-head"><view><text class="section-eyebrow">CONVERSATION</text><text class="section-title">全部回复</text></view><text class="section-caption">{{post.comments}} 条</text></view>
  <view wx:for="{{post.commentsList}}" wx:key="index" class="comment-row">
    <view class="avatar small-avatar comment-avatar" style="background: {{index % 2 === 0 ? '#7f73bd' : '#db9c4e'}}"><image wx:if="{{item.avatar}}" class="avatar-image" src="{{item.avatar}}" mode="aspectFill"/><text wx:if="{{!item.avatar}}">{{item.initials}}</text></view>
    <view class="comment-main"><view class="comment-head"><text class="comment-name">{{item.name}}</text><text class="comment-index">0{{index + 1}}</text></view><text class="comment-text">{{item.text}}</text></view>
  </view>
  <view wx:if="{{!post.commentsList.length}}" class="empty small-empty"><text class="empty-symbol">◌</text><text>还没有回复，来做第一个回应的人</text></view>

  <view class="comment-bar"><view class="comment-input-wrap"><text class="comment-input-icon">↗</text><input class="comment-input" placeholder="写下你的回应..." value="{{comment}}" bindinput="onComment" confirm-type="send" bindconfirm="submitComment"/></view><button class="send-button" bindtap="submitComment">发送</button></view>
</view>
<view wx:else class="empty detail-empty">这条讨论不存在或已被删除</view>
