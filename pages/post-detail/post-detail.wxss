.detail-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 176rpx;
  background: var(--bg);
}

.detail-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 22rpx;
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.detail-hot {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  color: var(--ink);
  background: var(--yellow);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.detail-content-panel {
  padding: 26rpx 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: 0 16rpx 36rpx rgba(84, 56, 22, 0.08);
}

.detail-author {
  display: flex;
  align-items: center;
}

.detail-avatar {
  width: 84rpx;
  height: 84rpx;
  overflow: hidden;
  border: 5rpx solid #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 18rpx rgba(22, 19, 16, 0.12);
}

.avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.author-meta {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.author-name-row {
  display: flex;
  align-items: center;
}

.author-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.author-mark {
  padding: 4rpx 9rpx;
  margin-left: 9rpx;
  border-radius: 6rpx;
  color: var(--coral);
  background: var(--coral-soft);
  font-size: 17rpx;
}

.author-role {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-time {
  align-self: flex-start;
  padding-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
  white-space: nowrap;
}

.detail-title {
  display: block;
  margin-top: 30rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}

.detail-content {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.8;
}

.post-tags {
  margin-top: 20rpx;
}

.post-tags .tag {
  margin-bottom: 0;
  color: var(--ink-soft);
  background: #eef4ef;
}

.detail-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.action-button {
  display: flex;
  align-items: center;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 700;
}

.action-icon {
  margin-right: 8rpx;
  color: var(--ink);
  font-size: 35rpx;
  line-height: 1;
}

.reply-icon {
  font-size: 28rpx;
}

.action-label {
  margin-left: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 400;
}

.action-button.liked,
.action-button.liked .action-icon {
  color: var(--coral);
}

.action-divider {
  width: 1rpx;
  height: 30rpx;
  margin: 0 30rpx;
  background: var(--line);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 4rpx 18rpx;
}

.section-eyebrow {
  display: block;
  margin-bottom: 7rpx;
  color: var(--coral);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.section-title {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 800;
}

.section-caption {
  padding-bottom: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.comment-row {
  display: flex;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.comment-avatar {
  overflow: hidden;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
}

.comment-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-name {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.comment-index {
  color: #c5b9aa;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.comment-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.small-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 80rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.empty-symbol {
  margin-right: 10rpx;
  color: var(--yellow);
  font-size: 32rpx;
}

.comment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 250, 241, 0.97);
}

.comment-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: #fff;
}

.comment-input-icon {
  margin-right: 10rpx;
  color: var(--coral);
  font-size: 25rpx;
  transform: rotate(-45deg);
}

.comment-input {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 24rpx;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 76rpx;
  margin-left: 14rpx;
  border-radius: 20rpx;
  color: #fff;
  background: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
}

.detail-empty {
  padding-top: 180rpx;
}
