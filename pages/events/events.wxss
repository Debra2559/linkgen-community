.events-page { padding-bottom: 120rpx; }
.page-title { display: block; margin-top: 10rpx; }
.eyebrow { color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.view-tabs { display: flex; height: 86rpx; margin: 4rpx -32rpx 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); background: rgba(255, 254, 249, .88); }.view-tab { position: relative; flex: 1; color: var(--muted); font-size: 27rpx; text-align: center; line-height: 86rpx; }.view-tab.active { color: var(--coral); font-weight: 800; }.view-tab.active::after { position: absolute; right: 36rpx; bottom: -1rpx; left: 36rpx; height: 5rpx; border-radius: 5rpx 5rpx 0 0; background: var(--coral); content: ''; }
.mine-create-button { display: flex; align-items: center; justify-content: center; height: 72rpx; margin-top: 20rpx; border: 1rpx solid var(--coral); border-radius: 18rpx; color: var(--coral); background: var(--coral-soft); font-size: 24rpx; font-weight: 800; }
.filter-area { position: relative; }
.filter-row { display: flex; gap: 12rpx; padding: 24rpx 0 8rpx; }
.filter-pill { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; height: 66rpx; padding: 0 8rpx; border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--card); color: var(--ink-soft); font-size: 22rpx; white-space: nowrap; }
.filter-pill.open, .filter-pill:active { border-color: var(--coral); color: var(--coral); }
.filter-chevron { margin-left: 8rpx; font-size: 22rpx; }
.create-plus { margin-right: 7rpx; color: var(--coral); font-size: 30rpx; }
.filter-menu { padding: 8rpx 0; margin: 8rpx 0 8rpx; border: 1rpx solid var(--line); }
.filter-option { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; color: var(--ink-soft); font-size: 23rpx; }
.filter-option.selected { color: var(--coral); background: var(--coral-soft); }
.filter-check { font-size: 24rpx; font-weight: 800; }
.timeline-capacity { display: block; margin-top: 7rpx; overflow: hidden; color: var(--coral); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.timeline-summary { display: flex; align-items: flex-end; justify-content: space-between; padding: 28rpx 0 20rpx; }.summary-title { display: block; color: var(--ink); font-size: 35rpx; font-weight: 800; }.summary-caption { display: block; margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }.summary-range { color: var(--muted); font-size: 18rpx; letter-spacing: 2rpx; }
.timeline { position: relative; }.timeline-group { position: relative; padding-bottom: 20rpx; }.day-marker { position: relative; z-index: 2; display: flex; align-items: baseline; padding-left: 4rpx; background: var(--bg); }.day-dot { width: 20rpx; height: 20rpx; margin-right: 17rpx; border: 5rpx solid var(--bg); border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 2rpx var(--line); }.day-date { color: var(--ink); font-size: 29rpx; font-weight: 800; }.day-week { margin-left: 10rpx; color: var(--muted); font-size: 22rpx; }.day-line { position: absolute; top: 22rpx; bottom: 22rpx; left: 13rpx; width: 2rpx; background: var(--line); }.timeline-item { position: relative; display: flex; align-items: flex-start; margin: 20rpx 0 24rpx 42rpx; }.timeline-time { width: 80rpx; flex-shrink: 0; padding-top: 27rpx; color: var(--muted); font-size: 20rpx; font-weight: 600; }.timeline-card { display: flex; flex: 1; min-width: 0; min-height: 220rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--card); box-shadow: var(--shadow); }.timeline-copy { flex: 1; min-width: 0; padding-right: 14rpx; }.timeline-type-row { display: flex; align-items: center; justify-content: space-between; }.event-type { color: var(--coral); font-size: 20rpx; font-weight: 800; }.event-status { color: var(--ink-soft); font-size: 18rpx; }.timeline-title { display: block; margin-top: 12rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; line-height: 1.35; }.timeline-description { display: -webkit-box; overflow: hidden; margin-top: 9rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.timeline-organizer, .timeline-location { display: block; margin-top: 13rpx; overflow: hidden; color: var(--ink-soft); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.timeline-location { margin-top: 7rpx; color: var(--muted); }.event-cover { display: flex; flex-direction: column; justify-content: space-between; width: 138rpx; height: 166rpx; flex-shrink: 0; padding: 14rpx; border-radius: 18rpx; color: var(--ink); }.cover-label { font-size: 22rpx; font-weight: 900; line-height: 1.18; word-break: break-all; }.cover-mark { align-self: flex-end; font-size: 15rpx; font-weight: 800; letter-spacing: 1rpx; }
.timeline-empty { padding: 100rpx 0 120rpx; font-size: 24rpx; }
.calendar-mode-bar { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0 4rpx; }.calendar-mode-label { color: var(--muted); font-size: 20rpx; }.calendar-mode-options { display: flex; padding: 4rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: rgba(255,255,255,.72); }.calendar-mode { min-width: 72rpx; padding: 11rpx 15rpx; border-radius: 999rpx; color: var(--muted); font-size: 20rpx; text-align: center; }.calendar-mode.active { color: var(--ink); background: var(--yellow); font-weight: 800; box-shadow: 0 3rpx 8rpx rgba(22,19,16,.08); }
.week-strip .calendar-day-chip { width: 13.5%; }
.calendar-panel { padding-bottom: 28rpx; }.calendar-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0 18rpx; }.calendar-nav { width: 62rpx; height: 62rpx; padding: 0; border: 1rpx solid var(--line); border-radius: 50%; color: var(--ink); background: var(--card); font-size: 42rpx; line-height: 53rpx; }.calendar-nav::after { border: 0; }.calendar-heading { flex: 1; text-align: center; }.calendar-heading-title { display: block; color: var(--ink); font-size: 32rpx; font-weight: 900; }.calendar-heading-caption { display: block; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }.calendar-day-strip { display: flex; justify-content: space-between; padding: 8rpx 0 20rpx; }.calendar-day-chip { position: relative; display: flex; width: 17%; flex-direction: column; align-items: center; padding: 13rpx 0 12rpx; border: 1rpx solid transparent; border-radius: 18rpx; color: var(--muted); }.calendar-day-chip.selected { border-color: var(--coral); color: var(--ink); background: var(--coral-soft); }.calendar-week-short { font-size: 18rpx; }.calendar-day-number { margin-top: 8rpx; color: var(--ink); font-size: 27rpx; font-weight: 800; }.calendar-day-dot { width: 8rpx; height: 8rpx; margin-top: 8rpx; border-radius: 50%; background: var(--coral); }
.calendar-list-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 18rpx 0 16rpx; border-top: 1rpx solid var(--line); }.calendar-list-title { display: block; color: var(--ink); font-size: 30rpx; font-weight: 900; }.calendar-list-caption { display: block; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }.calendar-list-range { color: var(--muted); font-size: 18rpx; }.calendar-event-group { margin-bottom: 22rpx; }.calendar-group-date { display: flex; align-items: baseline; gap: 10rpx; padding: 8rpx 0 10rpx; color: var(--ink); font-size: 23rpx; font-weight: 800; }.calendar-group-date text:last-child { color: var(--muted); font-size: 19rpx; font-weight: 400; }.calendar-event-row { display: flex; align-items: center; min-height: 112rpx; margin-bottom: 12rpx; padding: 18rpx 16rpx 18rpx 0; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--card); box-shadow: 0 8rpx 24rpx rgba(22,19,16,.04); }.calendar-event-time { width: 102rpx; flex-shrink: 0; padding-left: 18rpx; color: var(--muted); font-size: 20rpx; font-weight: 700; }.calendar-event-body { flex: 1; min-width: 0; }.calendar-event-topline { display: flex; justify-content: space-between; }.calendar-event-title { display: block; margin-top: 7rpx; overflow: hidden; color: var(--ink); font-size: 23rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.calendar-event-meta { display: block; margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.calendar-event-color { width: 12rpx; height: 72rpx; flex-shrink: 0; margin-left: 14rpx; border-radius: 12rpx 0 0 12rpx; }
.calendar-empty { padding: 90rpx 0 120rpx; font-size: 23rpx; }.month-calendar { padding-bottom: 16rpx; }.month-weekdays { display: flex; padding: 6rpx 0 10rpx; color: var(--muted); font-size: 18rpx; text-align: center; }.month-weekdays text { width: 14.2857%; }.month-grid { display: flex; flex-wrap: wrap; border-top: 1rpx solid var(--line); border-left: 1rpx solid var(--line); }.month-cell { position: relative; display: flex; width: 14.2857%; height: 84rpx; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 13rpx; border-right: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); color: var(--ink); }.month-cell.empty-cell { background: rgba(245,241,232,.35); }.month-cell.selected { background: var(--coral-soft); box-shadow: inset 0 -4rpx 0 var(--coral); }.month-cell-number { font-size: 22rpx; font-weight: 800; }.month-cell-dot { width: 9rpx; height: 9rpx; margin-top: 9rpx; border-radius: 50%; background: var(--coral); }.month-cell-count { position: absolute; right: 7rpx; bottom: 5rpx; color: var(--coral); font-size: 16rpx; }
