-coral); }
.calendar-list-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 18rpx 0 16rpx; border-top: 1rpx solid var(--line); }.calendar-list-title { display: block; color: var(--ink); font-size: 30rpx; font-weight: 900; }.calendar-list-caption { display: block; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }.calendar-list-range { color: var(--muted); font-size: 18rpx; }.calendar-event-group { margin-bottom: 22rpx; }.calendar-group-date { display: flex; align-items: baseline; gap: 10rpx; padding: 8rpx 0 10rpx; color: var(--ink); font-size: 23rpx; font-weight: 800; }.calendar-group-date text:last-child { color: var(--muted); font-size: 19rpx; font-weight: 400; }.calendar-event-row { display: flex; align-items: center; min-height: 112rpx; margin-bottom: 12rpx; padding: 18rpx 16rpx 18rpx 0; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--card); box-shadow: 0 8rpx 24rpx rgba(22,19,16,.04); }.calendar-event-time { width: 102rpx; flex-shrink: 0; padding-left: 18rpx; color: var(--muted); font-size: 20rpx; font-weight: 700; }.calendar-event-body { flex: 1; min-width: 0; }.calendar-event-topline { display: flex; justify-content: space-between; }.calendar-event-title { display: block; margin-top: 7rpx; overflow: hidden; color: var(--ink); font-size: 23rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.calendar-event-description { display: -webkit-box; overflow: hidden; margin-top: 5rpx; color: var(--ink-soft); font-size: 18rpx; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.calendar-event-organizer { display: block; margin-top: 5rpx; overflow: hidden; color: var(--muted); font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }.calendar-event-meta { display: block; margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.calendar-event-color { width: 12rpx; height: 112rpx; flex-shrink: 0; margin-left: 14rpx; border-radius: 12rpx 0 0 12rpx; }
.calendar-empty { padding: 90rpx 0 120rpx; font-size: 23rpx; }.month-calendar { padding: 18rpx 14rpx 14rpx; margin-top: 12rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: var(--card); box-shadow: 0 8rpx 24rpx rgba(22,19,16,.04); }.month-weekdays { display: flex; padding: 0 0 14rpx; color: var(--muted); font-size: 18rpx; text-align: center; }.month-weekdays text { width: 14.2857%; }.month-grid { display: flex; flex-wrap: wrap; overflow: hidden; border: 1rpx solid var(--line); border-radius: 15rpx; }.month-cell { position: relative; display: flex; width: 14.2857%; height: 84rpx; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 13rpx; border-right: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); color: var(--ink); background: var(--card); }.month-cell.empty-cell { background: rgba(10,17,34,.5); }.month-cell.selected { background: var(--coral-soft); box-shadow: inset 0 -4rpx 0 var(--coral); }.month-cell-number { font-size: 22rpx; font-weight: 800; }.month-cell-dot { width: 9rpx; height: 9rpx; margin-top: 9rpx; border-radius: 50%; background: var(--coral); }.month-cell-count { position: absolute; right: 7rpx; bottom: 5rpx; color: var(--coral); font-size: 16rpx; }

/* Timeline cards stay compact; the color block is a visual index, not a second panel. */
.timeline-item { margin-top: 14rpx; margin-bottom: 18rpx; }
.timeline-time { width: 68rpx; padding-top: 20rpx; font-size: 18rpx; }
.timeline-card { min-height: 0; padding: 16rpx; border-radius: 20rpx; }
.timeline-copy { padding-right: 10rpx; }
.event-type { font-size: 18rpx; }
