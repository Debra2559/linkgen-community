<view class="page events-page {{themeMode === 'light' ? 'theme-light' : ''}}">
  <view class="topbar"><view><text class="eyebrow">LINKGEN CALENDAR</text><text class="section-title page-title">活动</text></view><button wx:if="{{activeView === 'mine'}}" class="topbar-action" bindtap="goCreate"><text class="create-plus">＋</text><text>发起活动</text><text class="create-arrow">↗</text></button></view>

  <view class="view-tabs"><view class="view-tab {{activeView === 'community' ? 'active' : ''}}" data-view="community" bindtap="switchView">社区活动</view><view class="view-tab {{activeView === 'featured' ? 'active' : ''}}" data-view="featured" bindtap="switchView">精彩活动</view><view class="view-tab {{activeView === 'mine' ? 'active' : ''}}" data-view="mine" bindtap="switchView">我的活动</view></view>

  <view class="filter-area"><view class="filter-row"><button class="filter-pill {{activeFilterKey === 'type' ? 'open' : ''}}" data-key="type" bindtap="toggleFilterMenu">{{filterLabels.type}} <text class="filter-chevron">⌄</text></button><button class="filter-pill {{activeFilterKey === 'location' ? 'open' : ''}}" data-key="location" bindtap="toggleFilterMenu">{{filterLabels.location}} <text class="filter-chevron">⌄</text></button><button class="filter-pill {{activeFilterKey === 'status' ? 'open' : ''}}" data-key="status" bindtap="toggleFilterMenu">{{filterLabels.status}} <text class="filter-chevron">⌄</text></button></view>
    <view wx:if="{{filterMenuOpen}}" class="filter-menu card"><view wx:for="{{filterOptions}}" wx:key="key" class="filter-option {{item.key === filterValues[activeFilterKey] ? 'selected' : ''}}" data-value="{{item.key}}" bindtap="selectFilter"><text>{{item.label}}</text><text wx:if="{{item.key === filterValues[activeFilterKey]}}" class="filter-check">✓</text></view></view>
  </view>

  <view class="calendar-mode-bar"><text class="calendar-mode-label">查看方式</text><view class="calendar-mode-options"><view wx:for="{{calendarModes}}" wx:key="key" class="calendar-mode {{calendarMode === item.key ? 'active' : ''}}" data-mode="{{item.key}}" bindtap="switchCalendarMode">{{item.label}}</view></view></view>

  <view wx:if="{{calendarMode === 'timeline'}}" class="timeline-summary"><view><text class="summary-title">{{timelineTitle}}</text><text class="summary-caption">{{filteredEvents.length}} 场活动 · 按时间排序</text></view><text class="summary-range">{{timelineRange}}</text></view>
  <view wx:if="{{calendarMode === 'timeline' && activeView !== 'mine' && timelineGroups.length}}" class="timeline">
    <view wx:for="{{timelineGroups}}" wx:key="dateKey" class="timeline-group">
      <view class="day-marker"><view class="day-dot"></view><text class="day-date">{{item.dateLabel}}</text><text class="day-week">{{item.weekLabel}}</text></view>
      <view class="day-line"></view>
      <view wx:for="{{item.events}}" wx:for-item="event" wx:for-index="eventIndex" wx:key="id" class="timeline-item" data-id="{{event.id}}" bindtap="openEvent">
        <view class="timeline-time">{{event.timeShort}}</view>
        <view class="timeline-card"><view class="timeline-copy"><view class="timeline-type-row"><text class="event-type">{{event.type}}</text><text class="event-status">{{event.status}}</text></view><text class="timeline-title">{{event.title}}</text><text class="timeline-description">{{event.description}}</text><text class="timeline-organizer">◉ 由 {{event.organizer}} 主办</text><text class="timeline-location">⌖ {{event.location}}</text><text wx:if="{{event.community !== false}}" class="timeline-capacity">♧ 社区报名 · {{event.attendees}} / {{event.max}} 人</text><text wx:else class="timeline-capacity external-capacity">↗ 外部报名 · 人数由主办方统计</text></view><image wx:if="{{event.coverImage}}" class="event-cover event-cover-image" src="{{event.coverImage}}" mode="aspectFill" /><view wx:else class="event-cover" style="background: {{event.color}}"><text class="cover-label">{{event.coverLabel}}</text><text class="cover-mark">LINKGEN</text></view></view>
      </view>
    </view>
  </view>
  <view wx:if="{{calendarMode === 'timeline' && activeView === 'mine' && timelineGroups.length}}" class="mine-activity-list">
    <view wx:for="{{timelineGroups}}" wx:key="dateKey" class="mine-date-section">
      <view class="mine-date-heading"><view class="mine-date-dot"></view><text class="mine-date-label">{{item.dateLabel}}</text><text class="mine-date-week">{{item.weekLabel}}</text></view>
      <view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="mine-event-card" data-id="{{event.id}}" bindtap="openEvent">
        <view class="mine-event-header"><text class="mine-event-time">{{event.timeShort}}</text><view class="mine-event-status"><text class="event-type">{{event.type}}</text><text class="event-status">{{event.status}}</text></view></view>
        <view class="mine-event-content"><view class="mine-event-copy"><text class="mine-event-title">{{event.title}}</text><text class="mine-event-description">{{event.description}}</text></view><image wx:if="{{event.coverImage}}" class="mine-event-cover mine-event-cover-image" src="{{event.coverImage}}" mode="aspectFill" /><view wx:else class="mine-event-cover" style="background: {{event.color}}"><text class="cover-label">{{event.coverLabel}}</text><text class="cover-mark">LINKGEN</text></view></view>
        <view class="mine-event-footer"><text class="mine-event-location">⌖ {{event.location}}</text><text wx:if="{{event.community !== false}}" class="mine-event-capacity">♧ {{event.attendees}} / {{event.max}} 人</text><text wx:else class="mine-event-capacity external-capacity">↗ 外部报名</text></view>
      </view>
    </view>
  </view>
  <view wx:if="{{calendarMode === 'timeline' && !timelineGroups.length}}" class="empty timeline-empty">{{emptyTitle}}<br/><text class="muted">{{emptyCopy}}</text></view>

  <view wx:if="{{calendarMode !== 'timeline'}}" class="calendar-panel">
    <view class="calendar-toolbar"><button class="calendar-nav" data-direction="-1" bindtap="moveCalendar"><text>‹</text></button><view class="calendar-heading"><text class="calendar-heading-overline">{{calendarMode === 'day' ? 'DAY VIEW' : calendarMode === 'week' ? 'WEEK VIEW' : 'MONTH VIEW'}}</text><text class="calendar-heading-title">{{calendarHeader}}</text><text class="calendar-heading-caption">{{calendarCaption}}</text></view><button class="calendar-nav" data-direction="1" bindtap="moveCalendar"><text>›</text></button></view>

    <view wx:if="{{calendarMode === 'day' || calendarMode === 'week'}}" class="calendar-day-strip {{calendarMode === 'week' ? 'week-strip' : 'day-strip'}}"><view wx:for="{{calendarDays}}" wx:key="dateKey" class="calendar-day-chip {{item.isSelected ? 'selected' : ''}} {{item.eventCount ? 'has-events' : ''}}" data-date="{{item.dateKey}}" bindtap="selectCalendarDate"><text class="calendar-week-short">{{item.weekShort}}</text><text class="calendar-day-number">{{item.dayNumber}}</text><view wx:if="{{item.eventCount}}" class="calendar-day-dot"></view></view></view>

    <view wx:if="{{calendarMode === 'month'}}" class="month-calendar"><view class="month-weekdays"><text wx:for="{{weekShortNames}}" wx:key="*this">{{item}}</text></view><view class="month-grid"><view wx:for="{{monthCells}}" wx:key="index" class="month-cell {{item.isEmpty ? 'empty-cell' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.eventCount ? 'has-events' : ''}}" data-date="{{item.dateKey}}" bindtap="selectCalendarDate"><text wx:if="{{!item.isEmpty}}" class="month-cell-number">{{item.dayNumber}}</text><view wx:if="{{item.eventCount}}" class="month-cell-dot"></view><text wx:if="{{item.eventCount > 1}}" class="month-cell-count">{{item.eventCount}}</text></view></view></view>

    <view class="calendar-list-heading"><view><text class="calendar-list-title">{{calendarListTitle}}</text><text class="calendar-list-caption">{{calendarEventCount}} 场活动</text></view><text class="calendar-list-range">{{calendarPeriodLabel}}</text></view>
    <view wx:if="{{calendarGroups.length}}" class="calendar-event-groups"><view wx:for="{{calendarGroups}}" wx:key="dateKey" class="calendar-event-group"><view class="calendar-group-date"><text>{{item.dateLabel}}</text><text>{{item.weekLabel}}</text></view><view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="calendar-event-row" data-id="{{event.id}}" bindtap="openEvent"><view class="calendar-event-time">{{event.timeShort}}</view><view class="calendar-event-body"><view class="calendar-event-topline"><text class="event-type">{{event.type}}</text><text class="event-status">{{event.status}}</text></view><text class="calendar-event-title">{{event.title}}</text><text class="calendar-event-description">{{event.description}}</text><text class="calendar-event-organizer">由 {{event.organizer}} 主办</text><text wx:if="{{event.community !== false}}" class="calendar-event-meta">⌖ {{event.location}} · {{event.attendees}} / {{event.max}} 人</text><text wx:else class="calendar-event-meta external-capacity">↗ {{event.location}} · 外部报名</text></view><image wx:if="{{event.coverImage}}" class="calendar-event-thumb" src="{{event.coverImage}}" mode="aspectFill" /><view wx:else class="calendar-event-color" style="background: {{event.color}}"></view></view></view></view>
    <view wx:if="{{!calendarGroups.length}}" class="empty calendar-empty">{{calendarEmptyTitle}}<br/><text class="muted">{{calendarEmptyCopy}}</text></view>
  </view>

</view>
