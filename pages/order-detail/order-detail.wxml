<view class="page {{themeMode === 'light' ? 'theme-light' : ''}}">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{order}}">
    <!-- 状态头 -->
    <view class="status-banner {{order.status}}">
      <view class="status-emoji">{{order.status === 'pending' ? '◷' : '✓'}}</view>
      <view class="status-text">
        <view class="status-main">{{order.status === 'pending' ? '厨房接单中' : '这单完成啦'}}</view>
        <view class="status-sub">{{order.status === 'pending' ? '下单时间 ' + order.timeText : '完成时间 ' + order.doneTimeText}}</view>
      </view>
    </view>

    <view
      wx:if="{{order.status === 'done' && order.notificationState && order.notificationState !== 'sent'}}"
      class="notification-warning"
    >
      <text class="notification-warning-title">微信通知未发送</text>
      <text class="notification-warning-copy">{{order.notificationError || '请重新下单并允许订阅消息'}}</text>
    </view>

    <!-- 下单人 -->
    <view class="card block">
      <view class="row">
        <text class="row-label">谁点的</text>
        <text class="row-value">{{order.name}}</text>
      </view>
      <view class="row" wx:if="{{isOwner && order.openidText}}">
        <text class="row-label">用户标识</text>
        <text class="row-value">{{order.openidText}}</text>
      </view>
      <view class="row" wx:if="{{order.remark}}">
        <text class="row-label">备注</text>
        <text class="row-value remark">{{order.remark}}</text>
      </view>
    </view>

    <!-- 菜品明细 -->
    <view class="card block">
      <view class="block-title">菜品明细</view>
      <view wx:for="{{order.items}}" wx:key="dishId" class="dish-row">
        <text class="dish-emoji">✦</text>
        <text class="dish-name">{{item.name}}</text>
        <text class="dish-count">×{{item.count}}</text>
      </view>
      <view class="total-row">
        <text>合计（{{order.totalCount}} 份）</text>
      </view>
    </view>

    <!-- owner 操作 -->
    <view class="owner-actions" wx:if="{{isOwner}}">
      <button class="action-btn {{order.status === 'pending' ? 'primary' : 'plain'}}" bindtap="onToggleStatus" hover-class="btn-hover">
        {{order.status === 'pending' ? '做好了，标记完成' : '恢复为待处理'}}
      </button>
    </view>
  </block>
</view>
