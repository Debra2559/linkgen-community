<view class="page form-page profile-form-page">
  <view class="form-intro">
    <text class="eyebrow">MAKE YOURSELF KNOWN</text>
    <text class="form-title">你的名片<br/><text class="coral-word">值得被看见</text></text>
    <text class="form-copy">填得越具体，越容易遇见真正合拍的人。</text>
  </view>

  <view class="profile-preview">
    <view class="preview-top"><text class="preview-label">LINKGEN MEMBER CARD</text><text class="preview-live">实时预览</text></view>
    <view class="preview-main"><view class="avatar preview-avatar" style="background: {{profile.color}}"><image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><text wx:if="{{!profile.avatar}}">{{profile.initials || '你'}}</text></view><view class="preview-info"><text class="preview-name">{{profile.name || '你的昵称'}}</text><text class="preview-role">{{profile.role || '身份'}}<text wx:if="{{profile.city}}"> · {{profile.city}}</text></text></view></view>
    <text class="preview-bio">{{profile.bio || '一句话介绍自己，让别人快速认识你。'}}</text>
    <view class="preview-tags"><text wx:for="{{profile.tags}}" wx:key="*this" class="preview-tag">#{{item}}</text><text wx:if="{{!profile.tags || !profile.tags.length}}" class="preview-placeholder">添加你的社群标签</text></view>
  </view>

  <view class="avatar-section">
    <view class="avatar-section-head"><view><text class="section-kicker">PROFILE IMAGE</text><text class="block-title">选一张代表你的头像</text></view><button class="upload-button" bindtap="chooseUpload">上传照片</button></view>
    <scroll-view scroll-x class="avatar-scroll" show-scrollbar="{{false}}"><view wx:for="{{avatarOptions}}" wx:key="id" class="avatar-choice {{profile.avatarId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseAvatar"><image class="avatar-choice-image" src="{{item.path}}" mode="aspectFill"/><text class="avatar-choice-name">{{item.label}}</text></view></scroll-view>
  </view>

  <view class="section-block">
    <view class="block-heading"><text class="section-kicker">01 · 基础信息</text><text class="section-caption">别人先看到这些</text></view>
    <view class="field-line"><text class="field-label">昵称</text><input class="line-input" value="{{profile.name}}" maxlength="12" placeholder="例如：小满" bindinput="onName" /></view>
    <view class="field-line"><text class="field-label">身份</text><input class="line-input" value="{{profile.role}}" placeholder="例如：AI 产品经理" bindinput="onRole" /></view>
    <view class="field-line"><text class="field-label">所在城市</text><input class="line-input" value="{{profile.city}}" placeholder="例如：上海" bindinput="onCity" /></view>
  </view>

  <view class="section-block">
    <view class="block-heading"><text class="section-kicker">02 · 让人认识你</text><text class="section-caption">写真实一点</text></view>
    <view class="field-line"><view class="field-label-row"><text class="field-label">一句话介绍</text><text class="field-count">{{profile.bio.length}} / 80</text></view><textarea class="line-textarea" maxlength="80" value="{{profile.bio}}" placeholder="你正在做什么？对什么感兴趣？" bindinput="onBio" /></view>
    <view class="field-line"><view class="field-label-row"><text class="field-label">来社群的目的</text><text class="field-count">{{profile.purpose.length}} / 80</text></view><textarea class="line-textarea purpose-area" maxlength="80" value="{{profile.purpose}}" placeholder="你想认识谁？正在寻找什么？" bindinput="onPurpose" /></view>
  </view>

  <view class="section-block tag-section">
    <view class="block-heading"><view><text class="section-kicker">03 · 社群标签</text><text class="block-title">选择最像你的 3 个词</text></view><text class="section-caption">{{profile.tags.length}} / 3</text></view>
    <view class="choice-wrap"><view wx:for="{{tagOptions}}" wx:key="*this" class="choice {{profile.tags.indexOf(item) >= 0 ? 'chosen' : ''}}" data-tag="{{item}}" bindtap="toggleTag"><text class="choice-mark">#</text><text>{{item}}</text><text wx:if="{{profile.tags.indexOf(item) >= 0}}" class="choice-check">✓</text></view></view>
  </view>

  <view class="visibility-note"><text class="note-dot">·</text><text>名片会公开展示在通讯录，只有你能修改。</text></view>
  <view class="form-actions"><button class="secondary-button preview-button" bindtap="previewProfile">预览名片 <text class="button-arrow">↗</text></button><button class="primary-button submit-button" bindtap="save">保存名片 <text class="button-arrow">✓</text></button></view>
</view>
