/* pages/menu/menu.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

/* ===== 顶部：家庭餐桌品牌区 ===== */
.header {
  padding: 28rpx 28rpx 24rpx;
  background: var(--brand-grad);
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(139, 55, 30, 0.18);
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-title {
  display: flex;
  align-items: center;
}
.shop-emoji {
  width: 80rpx;
  height: 80rpx;
  background: #fff4e9;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 18rpx;
}
.shop-names {
  display: flex;
  flex-direction: column;
}
.shop-kicker {
  font-size: 20rpx;
  color: rgba(255, 250, 244, 0.78);
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}
.shop-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3rpx;
}
.header-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}
.header-caption {
  font-size: 23rpx;
  color: rgba(255, 250, 244, 0.9);
}
.header-mark {
  font-size: 17rpx;
  color: rgba(255, 250, 244, 0.58);
  letter-spacing: 2rpx;
}
.order-entry {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff8f0;
  background: rgba(75, 34, 23, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
}
.order-entry-icon {
  font-size: 30rpx;
  line-height: 1;
  margin-right: 8rpx;
}
.btn-hover {
  opacity: 0.75;
}

/* ===== 加载中 ===== */
.loading {
  padding: 160rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
}
.loading-mark {
  display: inline-block;
  color: var(--blush);
  font-size: 42rpx;
  line-height: 1;
  animation: loading-breathe 1.4s ease-in-out infinite;
}
@keyframes loading-breathe {
  0%, 100% { opacity: 0.35; transform: scale(0.82); }
  50% { opacity: 1; transform: scale(1); }
}

/* ===== 主体双栏 ===== */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.menu-empty {
  flex: 1;
  padding-top: 180rpx;
  text-align: center;
  color: var(--text-sub);
}
.menu-empty .empty-emoji {
  color: var(--brand);
  font-size: 72rpx;
  font-family: var(--font-display);
  margin-bottom: 20rpx;
}
.menu-empty .empty-text {
  padding: 0 48rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.retry-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 左侧分类 */
.sidebar {
  width: 172rpx;
  height: 100%;
  background: #efe7df;
  border-right: 1rpx solid #e7ddd3;
}
.cat-item {
  position: relative;
  padding: 30rpx 12rpx;
  font-size: 26rpx;
  color: #8e7c70;
  text-align: center;
}
.cat-item.on {
  margin: 8rpx 10rpx;
  padding: 28rpx 8rpx;
  background: #fffaf5;
  color: var(--brand);
  font-weight: 700;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(105, 68, 45, 0.08);
}
.cat-item.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 34rpx;
  border-radius: 6rpx;
  background: var(--brand);
}

/* 右侧菜品 */
.dish-scroll {
  flex: 1;
  height: 100%;
  background: var(--bg);
  padding: 0 22rpx;
}
.dish-section {
  padding-top: 4rpx;
}
.sec-title {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-main);
  padding: 28rpx 4rpx 8rpx;
}
.sec-title::before {
  content: '';
  width: 10rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: var(--brand);
  margin-right: 12rpx;
}
.sec-count {
  margin-left: 12rpx;
  color: var(--text-sub);
  font-size: 20rpx;
  font-weight: 400;
  background: #eee5dc;
  border-radius: 999rpx;
  padding: 5rpx 12rpx;
}

/* 菜品卡片 */
.dish-card {
  display: flex;
  padding: 16rpx;
  margin: 14rpx 0;
  background: var(--card);
  border-radius: 22rpx;
  border: 1rpx solid rgba(228, 216, 205, 0.72);
  box-shadow: var(--shadow-card);
}
.dish-photo-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eee5dc;
  flex-shrink: 0;
}
.dish-photo {
  display: block;
  width: 100%;
  height: 100%;
}
.dish-photo-label {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(45, 36, 31, 0.68);
  color: #fff;
  font-size: 18rpx;
}
.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.dish-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}
.dish-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-main);
}
.soldout {
  font-size: 20rpx;
  color: #a39892;
  background: #f1e9e2;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.dish-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
}

/* 加减步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}
.step-btn.plus {
  background: var(--brand-grad);
  color: #ffffff;
  box-shadow: var(--shadow-brand);
}
.step-btn.minus {
  border: 2rpx solid #e5cdbd;
  color: var(--brand);
  background: #ffffff;
}
.step-count {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}

.bottom-space {
  height: 48rpx;
}

/* ===== 底部购物车栏：悬浮黑金胶囊 ===== */
.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #292421;
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(41, 36, 33, 0.35);
}
.cart-left {
  display: flex;
  align-items: center;
}
.cart-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -36rpx;
  box-shadow: 0 8rpx 20rpx rgba(165, 63, 33, 0.4);
}
.cart-icon {
  color: #fffefa;
  font-size: 42rpx;
  font-family: var(--font-display);
}
.badge {
  position: absolute;
  top: -4rpx;
  right: -12rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}
.cart-total {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  margin-left: 22rpx;
  letter-spacing: 1rpx;
}
.cart-count-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 22rpx;
}
.checkout-btn {
  background: var(--brand-grad);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 22rpx 54rpx;
  box-shadow: var(--shadow-brand);
}

/* ===== 购物车弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 60vh;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.cart-panel.show {
  transform: translateY(0);
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}
.panel-clear {
  font-size: 26rpx;
  color: var(--text-sub);
}
.panel-list {
  max-height: 44vh;
  padding: 0 28rpx;
}
.panel-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.panel-photo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #eee5dc;
  flex-shrink: 0;
}
.panel-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}
.panel-name {
  flex: 1;
  font-size: 28rpx;
}

/* ===== 水彩花园主题覆盖 ===== */
.header {
  position: relative;
  height: 286rpx;
  padding: 0;
  overflow: hidden;
  background: #477c68;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(44, 86, 68, 0.18);
}
.header-scene,
.header-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.header-scene { z-index: 0; }
.header-wash {
  z-index: 1;
  background: rgba(25, 67, 53, 0.42);
}
.header-content {
  position: relative;
  z-index: 2;
  height: 100%;
  padding: 30rpx 28rpx 24rpx;
}
.shop-emoji {
  width: 70rpx;
  height: 70rpx;
  margin-right: 16rpx;
  background: rgba(255, 254, 250, 0.82);
  border-radius: 50%;
  font-size: 38rpx;
}
.shop-kicker,
.shop-name,
.header-caption,
.header-note,
.header-mark {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(18, 51, 40, 0.2);
}
.shop-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
}
.shop-name {
  font-size: 40rpx;
  letter-spacing: 4rpx;
}
.order-entry {
  padding: 14rpx 20rpx;
  color: #fff;
  background: rgba(255, 254, 250, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 12rpx;
  font-size: 24rpx;
}
.order-entry-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}
.header-bottom {
  margin-top: 86rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.42);
}
.header-caption {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  font-family: var(--font-display);
}
.header-note {
  display: block;
  margin-top: 5rpx;
  font-size: 21rpx;
  opacity: 0.86;
}
.header-mark {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  opacity: 0.76;
}
.body,
.dish-scroll { background: var(--bg); }
.sidebar {
  width: 168rpx;
  background: #e9f1e9;
  border-right: 1rpx solid #d7e5da;
}
.cat-item {
  padding: 28rpx 12rpx;
  color: #789087;
  font-size: 24rpx;
}
.cat-item.on {
  margin: 8rpx 10rpx;
  padding: 26rpx 8rpx;
  color: var(--brand-deep);
  background: rgba(255, 254, 250, 0.96);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 18rpx rgba(52, 101, 79, 0.1);
}
.cat-item.on::before {
  width: 5rpx;
  height: 30rpx;
  background: var(--blush);
}
.sec-title {
  padding: 28rpx 4rpx 8rpx;
  color: var(--brand-deep);
  font-family: var(--font-display);
}
.sec-title::before { background: var(--blush); }
.sec-count {
  color: #7c958b;
  background: #e6f0e8;
}
.dish-card {
  padding: 14rpx;
  margin: 12rpx 0;
  background: rgba(255, 254, 250, 0.94);
  border: 1rpx solid #e0ebe1;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(51, 88, 70, 0.08);
}
.dish-photo-wrap {
  width: 154rpx;
  height: 154rpx;
  border-radius: 12rpx;
}
.dish-name { color: var(--text-main); }
.dish-desc { color: #82948c; }
.step-btn.plus {
  background: var(--brand);
  box-shadow: 0 7rpx 16rpx rgba(52, 106, 84, 0.24);
}
.step-btn.minus {
  border-color: #bdd5c4;
  color: var(--brand-deep);
}
.cart-bar {
  background: #234d42;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 72, 57, 0.25);
}
.cart-icon-wrap {
  background: var(--blush);
  box-shadow: 0 8rpx 18rpx rgba(185, 102, 84, 0.28);
}
.checkout-btn {
  background: var(--blush);
  border-radius: 12rpx;
  box-shadow: none;
}
.cart-panel {
  background: #fffefa;
  border-radius: 24rpx 24rpx 0 0;
}

/* 采购方式筛选：让用户快速找到今晚能做的那一批 */
.supply-filters {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 14rpx 18rpx 12rpx;
  background: var(--bg);
  border-bottom: 1rpx solid #e0ebe1;
}
.supply-filter {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  color: #71857c;
  background: #e8f1e9;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  font-size: 22rpx;
}
.supply-filter.on {
  color: #fff;
  background: var(--brand);
  box-shadow: 0 5rpx 12rpx rgba(47, 103, 83, 0.16);
}
.supply-tag {
  display: block;
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.2;
}
.supply-tag.stock {
  color: #477860;
  background: #e6f1e8;
}
.supply-tag.purchase {
  color: #9a6a3a;
  background: #f8eddb;
}
.supply-tag.retail {
  color: #9a5d63;
  background: #f8e6e5;
}

/* 横版 Hero 保持完整构图；菜单正文改为纸张目录感 */
.header {
  height: 300rpx;
  transition: height 0.24s ease;
}
.header-scene {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.24s ease;
}
.header-wash {
  background: rgba(25, 67, 53, 0.34);
}
.header-bottom {
  position: absolute;
  right: 28rpx;
  bottom: 30rpx;
  left: 28rpx;
  margin-top: 0;
  transition: opacity 0.18s ease, transform 0.24s ease;
}
.header.compact {
  height: 128rpx;
}
.header.compact .header-content {
  padding-top: 16rpx;
}
.header.compact .header-scene {
  transform: scale(1.08);
}
.header.compact .header-bottom {
  opacity: 0;
  transform: translateY(18rpx);
  visibility: hidden;
}
.dish-scroll {
  padding: 0 18rpx;
}
.sec-title {
  padding-top: 24rpx;
  padding-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.dish-card {
  padding: 12rpx 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #dfe9e0;
  border-radius: 0;
  box-shadow: none;
}
.dish-photo-wrap {
  width: 138rpx;
  height: 138rpx;
  border-radius: 10rpx;
}
.dish-info {
  margin-left: 16rpx;
}
.dish-name {
  font-family: var(--font-display);
  font-size: 31rpx;
  letter-spacing: 1rpx;
}
.dish-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
}
.dish-bottom {
  padding-top: 8rpx;
}
.step-btn.plus,
.step-btn.minus {
  width: 46rpx;
  height: 46rpx;
  font-size: 29rpx;
}
.step-btn.plus {
  box-shadow: none;
}
.step-count {
  min-width: 48rpx;
  font-size: 26rpx;
}
.bottom-space {
  height: 28rpx;
}
