/* pages/menu/menu.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff7f0;
}
.header-title {
  display: flex;
  align-items: center;
}
.shop-emoji {
  font-size: 44rpx;
  margin-right: 12rpx;
}
.shop-name {
  font-size: 36rpx;
  font-weight: 700;
}
.order-entry {
  font-size: 26rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.btn-hover {
  opacity: 0.7;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-sub);
}

/* 主体双栏 */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.sidebar {
  width: 180rpx;
  height: 100%;
  background: #f2ede9;
}
.cat-item {
  padding: 34rpx 20rpx;
  font-size: 27rpx;
  color: #6f6660;
  text-align: center;
  border-left: 6rpx solid transparent;
}
.cat-item.on {
  background: #ffffff;
  color: var(--brand);
  font-weight: 600;
  border-left-color: var(--brand);
}

.dish-scroll {
  flex: 1;
  height: 100%;
  background: #ffffff;
  padding: 0 24rpx;
}
.dish-section {
  padding-top: 8rpx;
}
.sec-title {
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 600;
  padding: 24rpx 0 8rpx;
}
.dish-card {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  box-shadow: none;
  border-radius: 0;
}
.dish-emoji {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  flex-shrink: 0;
}
.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}
.soldout {
  font-size: 20rpx;
  color: #9a8f8a;
  background: #f0e9e4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.dish-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.dish-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}

/* 加减步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}
.step-btn.plus {
  background: var(--brand);
  color: #fff;
}
.step-btn.minus {
  border: 2rpx solid var(--brand);
  color: var(--brand);
  background: #fff;
}
.step-count {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.bottom-space {
  height: 160rpx;
}

/* 底部购物车栏 */
.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 32rpx;
  background: #2b2320;
  border-radius: 999rpx;
  padding: 16rpx 16rpx 16rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 35, 32, 0.25);
}
.cart-left {
  display: flex;
  align-items: center;
}
.cart-icon-wrap {
  position: relative;
}
.cart-icon {
  font-size: 48rpx;
}
.badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}
.cart-total {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  margin-left: 24rpx;
}
.checkout-btn {
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 48rpx;
}

/* 购物车弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 60vh;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.cart-panel.show {
  transform: translateY(0);
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}
.panel-clear {
  font-size: 26rpx;
  color: var(--text-sub);
}
.panel-list {
  max-height: 44vh;
  padding: 0 28rpx;
}
.panel-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.panel-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}
.panel-name {
  flex: 1;
  font-size: 28rpx;
}
.panel-price {
  margin-right: 24rpx;
}
