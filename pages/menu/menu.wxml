<view class="page">
  <!-- 顶部：店名 + 订单入口 -->
  <view class="header {{heroCollapsed ? 'compact' : ''}}">
    <image class="header-scene" src="../../assets/scenes/menu-hero.jpg" mode="aspectFill" />
    <view class="header-wash"></view>
    <view class="header-content">
      <view class="header-top">
        <view class="header-title">
          <view class="shop-emoji">✽</view>
          <view class="shop-names">
            <text class="shop-kicker">TONIGHT · HOME TABLE</text>
            <text class="shop-name">家里饭桌</text>
          </view>
        </view>
        <button class="order-entry" bindtap="goOrders" hover-class="btn-hover">
          <text class="order-entry-icon">↗</text>
          <text>订单</text>
        </button>
      </view>
      <view class="header-bottom">
        <view>
          <text class="header-caption">今晚一起，慢慢吃饭</text>
          <text class="header-note">为喜欢的人，选几道刚刚好的菜</text>
        </view>
        <text class="header-mark">01 / MENU</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading"><text class="loading-mark">◌</text> 正在准备菜单…</view>

  <block wx:else>
    <scroll-view wx:if="{{allDishes.length}}" scroll-x class="menu-type-filters" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{menuTypes}}"
        wx:key="key"
        class="menu-type-filter {{menuType === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMenuType"
      >{{item.label}}</view>
    </scroll-view>

    <scroll-view wx:if="{{allDishes.length}}" scroll-x class="supply-filters" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{supplyFilters}}"
        wx:key="key"
        class="supply-filter {{supplyFilter === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSupplyFilter"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{sections.length}}" class="body">
      <!-- 左侧分类 -->
      <scroll-view scroll-y class="sidebar" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{sections}}"
          wx:key="_id"
          class="cat-item {{activeCategory === item._id ? 'on' : ''}}"
          data-id="{{item._id}}"
          bindtap="onTapCategory"
        >
          {{item.name}}
        </view>
      </scroll-view>

      <!-- 右侧菜品 -->
      <scroll-view
        scroll-y
        class="dish-scroll"
        scroll-into-view="{{scrollIntoId}}"
        scroll-with-animation
        bindscroll="onDishScroll"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view
          wx:for="{{sections}}"
          wx:key="_id"
          id="sec-{{item._id}}"
          class="dish-section"
        >
          <view class="sec-title">
            <text>{{item.name}}</text>
            <text class="sec-count">{{item.dishes.length}} 道</text>
          </view>
          <view wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="_id" class="dish-card card" bindtap="onDishTap" data-id="{{dish._id}}">
            <view class="dish-photo-wrap">
              <image wx:if="{{dish.image}}" class="dish-photo" src="{{dish.image}}" mode="aspectFill" lazy-load />
              <view wx:else class="dish-photo-fallback">{{dish.emoji || '锅'}}</view>
              <view class="dish-photo-label" wx:if="{{dish.soldOut}}">售罄</view>
            </view>
            <view class="dish-info">
              <view class="dish-name-row">
                <text class="dish-name">{{dish.name}}</text>
                <text wx:if="{{dish.soldOut}}" class="soldout">已售罄</text>
              </view>
              <text class="supply-tag {{dish.supplyType}}">{{dish.supplyTypeLabel}}</text>
              <view class="dish-desc">{{dish.desc}}</view>
              <view class="dish-bottom">
                <view class="stepper" wx:if="{{!dish.soldOut}}">
                  <view
                    wx:if="{{cartMap[dish._id]}}"
                    class="step-btn minus"
                    catchtap="onMinus"
                    data-id="{{dish._id}}"
                  >−</view>
                  <text wx:if="{{cartMap[dish._id]}}" class="step-count">{{cartMap[dish._id]}}</text>
                  <view class="step-btn plus" catchtap="onPlus" data-id="{{dish._id}}">＋</view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="bottom-space"></view>
      </scroll-view>
    </view>

    <view wx:else class="menu-empty">
      <view class="empty-emoji">✦</view>
      <view class="empty-text">{{menuError || '暂时没有可点的菜品'}}</view>
      <button class="retry-btn" bindtap="loadMenu">重新加载</button>
    </view>

    <!-- 底部购物车栏 -->
    <view class="cart-bar" wx:if="{{cartCount > 0}}">
      <view class="cart-left" bindtap="toggleCartPanel">
        <view class="cart-icon-wrap">
          <text class="cart-icon">✦</text>
          <view class="badge">{{cartCount}}</view>
        </view>
        <text class="cart-count-text">已选 {{cartCount}} 份</text>
      </view>
      <button class="checkout-btn" bindtap="goCart" hover-class="btn-hover">去下单</button>
    </view>

    <!-- 购物车弹层 -->
    <view class="mask" wx:if="{{showCartPanel}}" bindtap="toggleCartPanel"></view>
    <view class="cart-panel {{showCartPanel ? 'show' : ''}}">
      <view class="panel-header">
        <text class="panel-title">已选菜品</text>
        <text class="panel-clear" bindtap="clearCart">清空</text>
      </view>
      <scroll-view scroll-y class="panel-list">
        <view wx:for="{{cartList}}" wx:for-item="cartItem" wx:key="_id" class="panel-item">
          <image wx:if="{{cartItem.dish.image}}" class="panel-photo" src="{{cartItem.dish.image}}" mode="aspectFill" />
          <view wx:else class="panel-photo-fallback">{{cartItem.dish.emoji || '锅'}}</view>
          <text class="panel-name">{{cartItem.dish.name}}</text>
          <view class="stepper">
            <view class="step-btn minus" catchtap="onMinus" data-id="{{cartItem.dish._id}}">−</view>
            <text class="step-count">{{cartItem.count}}</text>
            <view class="step-btn plus" catchtap="onPlus" data-id="{{cartItem.dish._id}}">＋</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
