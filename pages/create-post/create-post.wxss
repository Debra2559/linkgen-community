.form-page {
  padding-top: 28rpx;
}

.type-switch { display: flex; padding: 6rpx; margin: 24rpx 0; border-radius: 18rpx; background: #eee9df; }
.type-option { flex: 1; padding: 14rpx 8rpx; border-radius: 14rpx; color: var(--muted); font-size: 22rpx; font-weight: 700; text-align: center; }
.type-option.active { color: var(--ink); background: #fff; box-shadow: 0 5rpx 14rpx rgba(84, 56, 22, 0.08); }
.task-block { margin-top: 24rpx; }
.task-input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 20rpx; }
.task-input-item, .event-picker { padding: 16rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--muted); background: #fff; font-size: 20rpx; }
.task-input-item input, .task-input-item picker, .event-picker picker { display: block; margin-top: 8rpx; color: var(--ink); font-size: 23rpx; }
.event-picker { display: flex; justify-content: space-between; margin-top: 14rpx; }

.form-intro {
  padding: 28rpx 6rpx 24rpx;
}

.intro-row,
.editor-heading,
.editor-footer,
.block-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow,
.section-kicker {
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.draft-status {
  padding: 7rpx 12rpx;
  color: var(--ink-soft);
  background: var(--yellow);
  border-radius: 999rpx;
  font-size: 19rpx;
}

.form-title {
  display: block;
  margin-top: 18rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.coral-word {
  color: var(--coral);
}

.form-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.editor-sheet {
  padding: 26rpx 24rpx 20rpx;
  margin-top: 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.editor-count,
.editor-footer {
  color: var(--muted);
  font-size: 19rpx;
}

.title-input {
  width: 100%;
  height: 88rpx;
  padding: 18rpx 0 8rpx;
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 700;
}

.editor-divider {
  height: 1rpx;
  background: var(--line);
}

.content-input {
  width: 100%;
  height: 250rpx;
  padding: 20rpx 0 10rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.editor-footer {
  align-items: flex-end;
  line-height: 1.4;
}

.editor-footer text:first-child {
  max-width: 74%;
}

.section-block {
  margin-top: 34rpx;
}

.section-kicker {
  display: block;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.block-title {
  display: block;
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

.block-hint {
  color: var(--muted);
  font-size: 20rpx;
}

.choice-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.choice {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  margin: 0 10rpx 10rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--ink-soft);
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
}

.choice-mark {
  margin-right: 4rpx;
  color: var(--coral);
}

.choice.chosen {
  border-color: var(--coral);
  color: var(--coral);
  background: var(--coral-soft);
}

.visibility-note {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0 0;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.note-dot {
  margin-right: 8rpx;
  color: var(--coral);
  font-size: 30rpx;
  line-height: 20rpx;
}

.submit-button {
  margin-top: 34rpx;
}

.button-arrow {
  margin-left: 14rpx;
  font-size: 30rpx;
}
