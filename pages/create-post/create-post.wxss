.form-page {
  padding-top: 28rpx;
}

.type-switch { display: flex; padding: 6rpx; margin: 24rpx 0; border-radius: 18rpx; background: var(--surface-raised); }
.type-option { flex: 1; padding: 14rpx 8rpx; border-radius: 14rpx; color: var(--muted); font-size: 22rpx; font-weight: 700; text-align: center; }
.type-option.active { color: var(--ink); background: var(--card); box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, 0.2); }
.task-block { margin-top: 24rpx; }
.task-input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 20rpx; }
.task-input-item, .event-picker { padding: 16rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--muted); background: #fff; font-size: 20rpx; }
.task-input-item input, .task-input-item picker, .event-picker picker { display: block; margin-top: 8rpx; color: var(--ink); font-size: 23rpx; }
.event-picker { display: flex; justify-content: space-between; margin-top: 14rpx; }

.form-intro {
  padding: 28rpx 6rpx 24rpx;
}

.intro-row,
.editor-heading,
.editor-footer,
.block-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.intro-context {
  display: flex;
  align-items: center;
}

.eyebrow,
.section-kicker {
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.draft-status {
  padding: 7rpx 12rpx;
  color: var(--ink-soft);
  background: var(--yellow);
  border-radius: 999rpx;
  font-size: 19rpx;
}

.draft-copy {
  margin-left: 14rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.form-title {
  display: block;
  margin-top: 18rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.coral-word {
  color: var(--coral);
}

.form-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.editor-sheet {
  padding: 28rpx 26rpx 22rpx;
  margin-top: 12rpx;
  border: 2rpx solid rgba(255, 113, 59, .13);
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: 0 20rpx 44rpx rgba(84, 56, 22, 0.11);
}

.editor-count,
.editor-footer {
  color: var(--muted);
  font-size: 19rpx;
}

.title-input {
  width: 100%;
  height: 88rpx;
  padding: 18rpx 0 8rpx;
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 700;
}

.editor-divider {
  height: 1rpx;
  background: var(--line);
}

.content-input {
  width: 100%;
  height: 420rpx;
  padding: 20rpx 0 10rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
  line-height: 1.75;
}

.editor-footer {
  align-items: flex-end;
  line-height: 1.4;
}

.editor-footer text:first-child {
  max-width: 74%;
}

.editor-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.media-tools {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.media-tool {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  min-width: 0;
  padding: 0 4rpx;
  margin: 0;
  color: var(--ink-soft);
  font-size: 21rpx;
  white-space: nowrap;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 7rpx;
  border: 1rpx solid var(--line);
  border-radius: 11rpx;
  color: var(--coral);
  background: var(--coral-soft);
  font-size: 19rpx;
  font-weight: 800;
}

.paste-link-button {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  margin-left: 10rpx;
  border-radius: 9rpx;
  color: var(--coral);
  background: var(--coral-soft);
  font-size: 18rpx;
  white-space: nowrap;
}

.attachment-section {
  padding-top: 28rpx;
}

.attachment-heading,
.link-composer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.attachment-count {
  color: var(--muted);
  font-size: 19rpx;
}

.attachment-scroll {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.attachment-card {
  position: relative;
  display: inline-flex;
  vertical-align: top;
  width: 164rpx;
  height: 164rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #fff;
}

.attachment-image,
.attachment-video {
  width: 100%;
  height: 100%;
}

.attachment-video {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--ink-soft);
  font-size: 18rpx;
}

.video-mark,
.link-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  color: var(--ink);
  background: var(--yellow);
  font-size: 18rpx;
}

.attachment-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 18rpx;
  text-align: center;
}

.attachment-link .link-mark {
  margin-bottom: 12rpx;
  color: var(--coral);
  background: var(--coral-soft);
}

.attachment-link-name,
.attachment-link-url {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-link-name {
  color: var(--ink-soft);
  font-size: 19rpx;
  font-weight: 700;
}

.attachment-link-url {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 16rpx;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.attachment-remove,
.link-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #fff;
  background: rgba(22, 19, 16, .72);
  font-size: 24rpx;
  line-height: 1;
}

.link-composer {
  position: relative;
  padding: 22rpx;
  margin-top: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: #fff;
}

.link-composer-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.link-close {
  position: static;
  flex-shrink: 0;
  color: var(--ink-soft);
  background: var(--coral-soft);
}

.link-input {
  width: 100%;
  height: 74rpx;
  padding: 0 16rpx;
  margin-top: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 13rpx;
  color: var(--ink-soft);
  background: var(--bg);
  font-size: 21rpx;
}

.link-composer-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.secondary-mini,
.primary-mini {
  height: 60rpx;
  padding: 0 18rpx;
  margin-left: 10rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
}

.secondary-mini {
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  background: #fff;
}

.primary-mini {
  color: #fff;
  background: var(--ink);
}

.section-block {
  margin-top: 34rpx;
}

.section-kicker {
  display: block;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.block-title {
  display: block;
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 800;
}

.block-hint {
  color: var(--muted);
  font-size: 20rpx;
}

.choice-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.choice {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  margin: 0 10rpx 10rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--ink-soft);
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
}

.choice-mark {
  margin-right: 4rpx;
  color: var(--coral);
}

.choice.chosen {
  border-color: var(--coral);
  color: var(--coral);
  background: var(--coral-soft);
}
.page:not(.theme-light) .choice.chosen { border-color: var(--coral) !important; color: #fff !important; background: var(--coral) !important; box-shadow: 0 0 0 3rpx rgba(155, 123, 255, .26), 0 8rpx 18rpx rgba(0, 0, 0, .24) !important; }
.page:not(.theme-light) .choice.chosen .choice-mark,
.page:not(.theme-light) .choice.chosen .choice-check { color: #fff !important; }

.visibility-note {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0 0;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.note-dot {
  margin-right: 8rpx;
  color: var(--coral);
  font-size: 30rpx;
  line-height: 20rpx;
}

.submit-button {
  margin-top: 34rpx;
}

.button-arrow {
  margin-left: 14rpx;
  font-size: 30rpx;
}
