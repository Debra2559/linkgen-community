<view class="page form-page post-form-page {{themeMode === 'light' ? 'theme-light' : ''}}">
  <view class="form-intro">
    <view class="intro-row"><view class="intro-context"><text class="eyebrow">START A CONVERSATION</text><text class="draft-copy">草稿自动保留</text></view><text class="draft-status">公开发布</text></view>
    <text class="form-title">把你的想法<br/><text class="coral-word">放到桌面上</text></text>
    <text class="form-copy">一个好问题，可能会遇见十个新朋友。</text>
  </view>

  <view class="editor-sheet">
    <view class="editor-heading"><text class="section-kicker">NEW DISCUSSION</text><text class="editor-count">{{title.length}} / 40</text></view>
    <input class="title-input" placeholder="先写一个让人想点开的标题" maxlength="40" value="{{title}}" bindinput="onTitle" />
    <view class="editor-divider"></view>
    <textarea class="content-input" placeholder="分享你的背景、问题或正在思考的事..." maxlength="2000" value="{{content}}" bindinput="onContent" show-confirm-bar="{{false}}" cursor-spacing="20" />
    <view class="editor-footer"><text>尽量具体，大家更容易接住你的话题</text><text>{{content.length}} / 2000</text></view>
    <view class="editor-toolbar">
      <view class="media-tools">
        <button class="media-tool" bindtap="addImage"><text class="tool-icon">▧</text><text>图片</text></button>
        <button class="media-tool" bindtap="addVideo"><text class="tool-icon">▶</text><text>视频</text></button>
        <button class="media-tool" bindtap="openLinkPanel"><text class="tool-icon">↗</text><text>链接</text></button>
      </view>
      <button class="paste-link-button" bindtap="pasteLink">粘贴链接</button>
    </view>
  </view>

  <view wx:if="{{attachments.length}}" class="attachment-section">
    <view class="attachment-heading"><text class="section-kicker">ATTACHMENTS</text><text class="attachment-count">{{attachments.length}} 个附件</text></view>
    <scroll-view scroll-x class="attachment-scroll" show-scrollbar="{{false}}">
      <view wx:for="{{attachments}}" wx:key="id" class="attachment-card">
        <image wx:if="{{item.type === 'image'}}" class="attachment-image" src="{{item.path}}" mode="aspectFill" />
        <view wx:elif="{{item.type === 'video'}}" class="attachment-video"><text class="video-mark">▶</text><text>视频</text></view>
        <view wx:else class="attachment-link"><text class="link-mark">↗</text><text class="attachment-link-name">{{item.name}}</text><text class="attachment-link-url">{{item.url}}</text></view>
        <button class="attachment-remove" catchtap="removeAttachment" data-index="{{index}}">×</button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{linkPanelOpen}}" class="link-composer">
    <view class="link-composer-head"><view><text class="section-kicker">ADD LINK</text><text class="link-composer-title">把外部内容带进来</text></view><button class="link-close" bindtap="closeLinkPanel">×</button></view>
    <input class="link-input" placeholder="粘贴公众号、小红书或网页链接" value="{{linkInput}}" bindinput="onLinkInput" />
    <view class="link-composer-actions"><button class="secondary-mini" bindtap="pasteLink">从剪贴板粘贴</button><button class="primary-mini" bindtap="saveLink">添加链接 ↗</button></view>
  </view>

  <view class="section-block tag-block">
    <view class="block-heading"><view><text class="section-kicker">给讨论加个方向</text><text class="block-title">选择标签</text></view><text class="block-hint">{{selectedTags.length}} / 3</text></view>
    <view class="choice-wrap"><view wx:for="{{tagOptions}}" wx:key="*this" class="choice {{selectedTags.indexOf(item) >= 0 ? 'chosen' : ''}}" data-tag="{{item}}" bindtap="toggleTag"><text class="choice-mark">#</text>{{item}}</view></view>
  </view>

  <view class="visibility-note"><text class="note-dot">·</text><text>发布后，社群成员都可以查看、评论和收藏这条讨论</text></view>
  <button class="primary-button submit-button" bindtap="submit">发布讨论 <text class="button-arrow">↗</text></button>
</view>
