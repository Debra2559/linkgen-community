.library-detail-page { padding-bottom: 110rpx; }.detail-kicker { color: var(--coral); font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; }.detail-title { display: block; margin-top: 14rpx; color: var(--ink); font-size: 42rpx; font-weight: 900; line-height: 1.2; }.detail-source { display: flex; align-items: center; padding: 18rpx 0 22rpx; border-bottom: 1rpx solid var(--line); }.detail-source-mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 16rpx; color: var(--ink); background: var(--yellow); font-size: 16rpx; font-weight: 900; }.detail-source-name, .detail-source-meta { display: block; margin-left: 13rpx; }.detail-source-name { color: var(--ink-soft); font-size: 21rpx; font-weight: 800; }.detail-source-meta { margin-top: 4rpx; color: var(--muted); font-size: 17rpx; }.detail-summary { padding: 22rpx; margin-top: 22rpx; border-radius: 18rpx; background: var(--mint); }.summary-label { display: block; color: var(--coral); font-size: 17rpx; font-weight: 800; }.summary-copy { display: block; margin-top: 10rpx; color: var(--ink-soft); font-size: 25rpx; line-height: 1.55; }.detail-tags { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 18rpx; }.detail-tag { padding: 7rpx 10rpx; border-radius: 8rpx; color: var(--coral); background: var(--coral-soft); font-size: 18rpx; }.detail-note { display: flex; flex-direction: column; gap: 4rpx; padding: 16rpx 0; margin-top: 24rpx; color: var(--muted); font-size: 18rpx; line-height: 1.4; }.detail-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }.detail-actions button { flex: 1; height: 62rpx; border-radius: 13rpx; font-size: 21rpx; }.detail-actions button::after { border: 0; }.save-button { color: var(--ink-soft); background: #fff; border: 1rpx solid var(--line); }.save-button.saved { color: #377b61; background: #e3f1e8; }.open-button { color: #fff; background: var(--coral); }.detail-updated { margin-top: 17rpx; color: var(--muted); font-size: 16rpx; }.empty { padding-top: 180rpx; color: var(--muted); text-align: center; font-size: 22rpx; }
