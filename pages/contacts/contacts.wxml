<view class="page contacts-page {{themeMode === 'light' ? 'theme-light' : ''}}">
  <view class="topbar"><view><text class="eyebrow">MEET THE COMMUNITY</text><text class="section-title page-title">通讯录</text></view><button class="icon-button" bindtap="goProfile">⌁</button></view>
  <view class="directory-intro"><view><text class="intro-title">找到和你同频的人</text><text class="intro-copy">每个人，都有一张可被发现的数字名片</text></view><view class="people-stack"><view class="stack-avatar"><image src="../../assets/avatars/avatar-soda.png" mode="aspectFill"/></view><view class="stack-avatar"><image src="../../assets/avatars/avatar-mia.png" mode="aspectFill"/></view><view class="stack-avatar"><image src="../../assets/avatars/avatar-aji.png" mode="aspectFill"/></view><text class="stack-more">+1.2k</text></view></view>
  <view class="search-box"><text class="search-icon">⌕</text><input class="search-input" placeholder="搜索姓名、介绍或标签" value="{{search}}" bindinput="onSearch" /></view>
  <view class="filter-caption"><text>按兴趣和连接诉求筛选</text><text>{{activeTag === '全部' ? '全部成员' : '已选：' + activeTag}}</text></view>
  <scroll-view scroll-x class="tag-scroll" show-scrollbar="{{false}}"><view wx:for="{{tags}}" wx:key="*this" class="topic-chip {{activeTag === item ? 'selected' : ''}}" data-tag="{{item}}" bindtap="onTag">{{item}}</view></scroll-view>
  <view class="section-head"><text class="section-title">社群成员</text><text class="section-caption">{{filteredMembers.length}} 位成员</text></view>
  <view wx:for="{{filteredMembers}}" wx:key="id" class="member-row" data-id="{{item.id}}" bindtap="openMember"><view class="avatar member-avatar" style="background: {{item.color}}"><image wx:if="{{item.avatar}}" class="avatar-image" src="{{item.avatar}}" mode="aspectFill"/><text wx:if="{{!item.avatar}}">{{item.initials}}</text></view><view class="member-main"><view class="member-name-row"><text class="member-name">{{item.name}}</text><view wx:if="{{item.online}}" class="online-dot"></view></view><text class="member-role">{{item.role}}<text wx:if="{{item.city}}"> · {{item.city}}</text></text><text class="member-purpose">{{item.purpose}}</text><view class="member-tags"><text wx:for="{{item.tags}}" wx:key="*this" class="mini-tag">{{item}}</text></view></view><text class="member-arrow">›</text></view>
  <view wx:if="{{!filteredMembers.length}}" class="empty">没有找到成员<br/><text class="muted">试试搜索“AI 产品”</text></view>
</view>
