.contacts-page { padding-bottom: 120rpx; }
.page-title { display: block; margin-top: 10rpx; }
.eyebrow { color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.directory-intro { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; border-radius: 22rpx; background: var(--mint); }
.intro-title { display: block; color: var(--ink); font-size: 27rpx; font-weight: 800; }
.intro-copy { display: block; margin-top: 8rpx; color: var(--ink-soft); font-size: 20rpx; }
.people-stack { display: flex; align-items: center; min-width: 150rpx; height: 54rpx; }
.stack-avatar { width: 48rpx; height: 48rpx; margin-left: -9rpx; overflow: hidden; border: 3rpx solid var(--mint); border-radius: 50%; background: var(--coral-soft); }
.stack-avatar:first-child { margin-left: 0; }
.stack-avatar image { display: block; width: 100%; height: 100%; }
.stack-more { margin-left: 6rpx; color: var(--ink-soft); font-size: 19rpx; }
.tag-scroll { white-space: nowrap; margin: -4rpx 0 20rpx; }
.topic-chip { display: inline-block; padding: 12rpx 20rpx; margin-right: 10rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: var(--surface-raised); font-size: 22rpx; }
.topic-chip.selected { border-color: var(--ink); color: #fff; background: var(--ink); }
.member-row { display: flex; align-items: flex-start; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.member-avatar { overflow: hidden; border-radius: 24rpx; }
.avatar-image { display: block; width: 100%; height: 100%; }
.member-main { flex: 1; min-width: 0; margin-left: 18rpx; }
.member-name-row { display: flex; align-items: center; }
.member-name { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.online-dot { width: 11rpx; height: 11rpx; margin-left: 10rpx; border-radius: 50%; background: #43b87a; }
.member-role { display: block; margin-top: 3rpx; color: var(--muted); font-size: 20rpx; }
.member-purpose { display: block; overflow: hidden; margin-top: 12rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.member-tags { margin-top: 10rpx; white-space: nowrap; overflow: hidden; }
.mini-tag { display: inline-block; margin-right: 8rpx; padding: 5rpx 10rpx; border-radius: 7rpx; background: var(--surface-raised); color: var(--ink-soft); font-size: 18rpx; }
.member-arrow { align-self: center; padding-left: 14rpx; color: var(--muted); font-size: 40rpx; font-weight: 200; }
