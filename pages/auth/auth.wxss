.auth-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 96rpx 42rpx 60rpx;
  background: #dce8d9;
  color: var(--text-main);
}
.auth-scene,
.auth-scene-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.auth-scene {
  z-index: 0;
}
.auth-scene-wash {
  z-index: 1;
  background: rgba(244, 246, 239, 0.38);
}
.auth-content {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 156rpx);
}
.auth-topline {
  color: #fff;
  font-size: 18rpx;
  letter-spacing: 5rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(26, 59, 47, 0.24);
}
.auth-title-row {
  display: flex;
  align-items: center;
  margin-top: 110rpx;
}
.auth-mark {
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 254, 250, 0.78);
  color: var(--brand);
  font-size: 58rpx;
  box-shadow: 0 16rpx 30rpx rgba(41, 79, 61, 0.16);
}
.auth-title {
  display: block;
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  text-shadow: 0 2rpx 12rpx rgba(26, 59, 47, 0.24);
}
.auth-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #fff;
  font-size: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(26, 59, 47, 0.22);
}
.auth-card {
  position: absolute;
  right: 0;
  bottom: 16rpx;
  left: 0;
  padding: 34rpx 30rpx 28rpx;
  background: rgba(255, 254, 250, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 24rpx;
  box-shadow: 0 22rpx 48rpx rgba(38, 71, 56, 0.18);
  backdrop-filter: blur(10px);
  text-align: left;
}
.auth-card-kicker {
  color: var(--brand);
  font-size: 18rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}
.auth-card-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  font-family: var(--font-display);
}
.auth-card-copy {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1.6;
}
.auth-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  padding: 18rpx 0;
  color: #fff;
  background: var(--brand);
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.auth-btn-arrow {
  margin-left: 16rpx;
  font-size: 34rpx;
  line-height: 1;
}
.auth-note {
  margin-top: 14rpx;
  color: #9aa8a0;
  font-size: 20rpx;
  text-align: center;
}
.auth-btn.disabled {
  opacity: 0.6;
}
