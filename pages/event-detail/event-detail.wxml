<view class="page event-detail-page" wx:if="{{event}}">
  <view class="event-detail-cover" style="background: {{event.color}}">
    <image wx:if="{{event.coverImage}}" class="detail-cover-image" src="{{event.coverImage}}" mode="aspectFill" />
    <view wx:if="{{event.coverImage}}" class="detail-cover-shade"></view>
    <view class="cover-grid"></view>
    <view class="hero-topline">
      <text class="hero-brand">LINKGEN / EVENT NOTE</text>
      <text class="hero-index">COMMUNITY EVENT</text>
    </view>
    <view class="hero-bottom">
      <view class="cover-labels">
        <text class="cover-type">{{event.type}}</text>
        <text wx:if="{{event.community === false}}" class="cover-scope">社区外精选</text>
        <text wx:else class="cover-scope community-scope">社区活动</text>
      </view>
      <view class="cover-date">
        <text class="cover-month">{{event.month}}</text>
        <text class="cover-day">{{event.day}}</text>
        <text class="cover-date-label">活动日</text>
      </view>
    </view>
  </view>

  <view class="detail-heading">
    <text class="detail-title">{{event.title}}</text>
    <view class="organizer-row" bindtap="openOrganizer">
      <view class="avatar small-avatar" style="background: {{event.organizerProfile.color}}"><image wx:if="{{event.organizerProfile.avatar}}" class="avatar-image" src="{{event.organizerProfile.avatar}}" mode="aspectFill" /><text wx:if="{{!event.organizerProfile.avatar}}">{{event.organizerProfile.initials}}</text></view>
      <view class="organizer-copy"><text class="organizer-label">发起人</text><text class="organizer-name">{{event.organizer}}</text></view>
      <text class="official-badge" wx:if="{{event.official}}">官方</text>
      <text class="organizer-action">查看 ›</text>
    </view>
  </view>

  <text class="event-description">{{event.description}}</text>

  <view class="info-list">
    <view class="info-item">
      <view class="info-icon">◷</view>
      <view class="info-copy"><text class="info-label">时间</text><text class="info-value">{{event.time}}</text></view>
    </view>
    <view class="info-item">
      <view class="info-icon">⌖</view>
      <view class="info-copy"><text class="info-label">地点</text><text class="info-value">{{event.location}}</text></view>
    </view>
    <view class="info-item">
      <view class="info-icon">♧</view>
      <view class="info-copy">
        <text class="info-label">报名情况</text>
        <text wx:if="{{event.community !== false}}" class="info-value">{{event.attendees}} / {{event.max}} 人已报名</text>
        <text wx:else class="info-value">人数由原活动主办方统计</text>
      </view>
    </view>
  </view>

  <view wx:if="{{event.sourceUrl}}" class="source-block">
    <view class="source-block-head"><text>活动来源</text><text class="source-platform-label">{{event.sourcePlatform}}</text></view>
    <text class="source-name">{{event.sourceName}}</text>
    <text class="source-summary">{{event.articleSummary}}</text>
    <button class="source-button" bindtap="copySource">复制原文链接</button>
  </view>

  <view class="action-zone">
    <button wx:if="{{event.community !== false}}" class="primary-button join-button {{event.joined ? 'joined' : ''}} {{event.full && !event.joined ? 'full' : ''}}" bindtap="toggleJoin" disabled="{{event.full && !event.joined}}">{{event.full && !event.joined ? '报名已满' : event.joined ? '已报名 · 到时见' : '报名参加'}} <text class="button-arrow">{{event.full && !event.joined ? '×' : event.joined ? '✓' : '↗'}}</text></button>
    <view wx:else class="external-actions"><button class="secondary-button calendar-button {{event.calendarAdded ? 'added' : ''}}" bindtap="toggleCalendar">{{event.calendarAdded ? '已加入日程' : '加入我的日程'}} <text class="button-arrow">{{event.calendarAdded ? '✓' : '+'}}</text></button><button class="primary-button external-link-button" bindtap="openRegistration">{{event.registrationUrl ? '报名链接' : '报名入口待补充'}} <text class="button-arrow">↗</text></button></view>
    <view class="share-note">{{event.community !== false ? '报名后可在「我的活动」里查看' : event.calendarAdded ? '已加入「我的活动」，报名请通过外部链接完成' : '外部活动不占用社区名额，报名由原主办方处理'}}</view>
  </view>

  <view wx:if="{{linkPanel}}" class="sheet-mask" catchtap="closeLinkPanel">
    <view class="link-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><view><text class="sheet-eyebrow">REGISTRATION LINK</text><text class="sheet-title">报名入口已复制</text></view><button class="sheet-close" bindtap="closeLinkPanel">×</button></view>
      <text class="sheet-copy">链接已放入剪贴板，可粘贴到浏览器打开。</text>
      <view class="link-preview"><text selectable="true">{{linkPanel}}</text></view>
      <view class="sheet-actions"><button class="sheet-secondary" bindtap="closeLinkPanel">关闭</button><button class="sheet-primary" bindtap="copyRegistrationAgain">再次复制</button></view>
    </view>
  </view>

  <view wx:if="{{organizerPanel}}" class="sheet-mask" catchtap="closeOrganizer">
    <view class="organizer-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><view><text class="sheet-eyebrow">ORGANIZER PROFILE</text><text class="sheet-title">发起人信息</text></view><button class="sheet-close" bindtap="closeOrganizer">×</button></view>
      <view class="organizer-profile-head">
        <view class="avatar organizer-avatar" style="background: {{event.organizerProfile.color}}"><image wx:if="{{event.organizerProfile.avatar}}" class="avatar-image" src="{{event.organizerProfile.avatar}}" mode="aspectFill" /><text wx:if="{{!event.organizerProfile.avatar}}">{{event.organizerProfile.initials}}</text></view>
        <view class="organizer-profile-copy"><text class="organizer-profile-name">{{event.organizerProfile.name}}</text><text class="organizer-profile-role">{{event.organizerProfile.role}}<text wx:if="{{event.organizerProfile.city}}"> · {{event.organizerProfile.city}}</text></text></view>
      </view>
      <view class="organizer-tags"><text wx:for="{{event.organizerProfile.tags}}" wx:key="*this" class="organizer-tag">#{{item}}</text></view>
      <text class="organizer-bio">{{event.organizerProfile.bio}}</text>
      <button wx:if="{{event.organizerProfile.memberId}}" class="sheet-primary member-link-button" bindtap="openOrganizerDirectory">查看完整数字名片</button>
    </view>
  </view>
</view>
<view wx:elif="{{loading}}" class="empty detail-empty">正在加载活动</view>
<view wx:else class="empty detail-empty">这场活动不存在或已被删除</view>
