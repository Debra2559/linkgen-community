<view class="page event-detail-page" wx:if="{{event}}"><view class="event-detail-cover" style="background: {{event.color}}"><view class="cover-labels"><text class="cover-type">{{event.type}}</text><text wx:if="{{event.community === false}}" class="cover-scope">社区外精选</text></view><view class="cover-date"><text class="cover-day">{{event.day}}</text><text>{{event.month}}</text></view></view><text class="detail-title">{{event.title}}</text><view class="organizer-row"><view class="avatar small-avatar" style="background: {{event.official ? '#10231f' : '#7f73bd'}}">{{event.official ? 'L' : 'R'}}</view><text>由 {{event.organizer}} 发起</text><text class="official-badge" wx:if="{{event.official}}">官方</text></view><text class="event-description">{{event.description}}</text><view class="info-list"><view><text class="info-icon">◷</text><text>{{event.time}}</text></view><view><text class="info-icon">⌖</text><text>{{event.location}}</text></view><view><text class="info-icon">♧</text><text>{{event.attendees}} / {{event.max}} 人已报名</text></view></view><button class="primary-button join-button {{event.joined ? 'joined' : ''}}" bindtap="toggleJoin">{{event.joined ? '已报名 · 到时见' : '报名参加'}} <text class="button-arrow">{{event.joined ? '✓' : '↗'}}</text></button><view class="share-note">报名后可在「我的活动」里查看</view></view><view wx:else class="empty detail-empty">这场活动不存在或已被删除</view>
