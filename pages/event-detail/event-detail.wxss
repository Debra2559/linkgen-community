.event-detail-page { padding-top: 20rpx; padding-bottom: 54rpx; }
.event-detail-cover { position: relative; height: 258rpx; padding: 22rpx; overflow: hidden; border-radius: 24rpx; color: #fff; }
.detail-cover-image, .detail-cover-shade, .cover-grid { position: absolute; inset: 0; width: 100%; height: 100%; }
.detail-cover-image { display: block; }
.detail-cover-shade { background: linear-gradient(180deg, rgba(22,19,16,.08), rgba(22,19,16,.48)); }
.cover-grid { opacity: .18; background-image: linear-gradient(90deg, transparent 49.5%, rgba(255,255,255,.8) 50%, transparent 50.5%), linear-gradient(0deg, transparent 49.5%, rgba(255,255,255,.8) 50%, transparent 50.5%); background-size: 92rpx 92rpx; }
.hero-topline, .hero-bottom { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
.hero-topline { color: rgba(255,255,255,.76); font-size: 16rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-index { padding: 5rpx 8rpx; border: 1rpx solid rgba(255,255,255,.42); border-radius: 5rpx; font-size: 14rpx; letter-spacing: 1rpx; }
.hero-bottom { position: absolute; right: 22rpx; bottom: 22rpx; left: 22rpx; align-items: flex-end; }
.cover-labels { display: flex; flex-direction: column; align-items: flex-start; }
.cover-type, .cover-scope { padding: 7rpx 12rpx; border-radius: 8rpx; background: rgba(0,0,0,.18); font-size: 19rpx; }
.cover-scope { margin-top: 7rpx; color: var(--ink); background: var(--yellow); font-size: 16rpx; }
.community-scope { color: var(--coral); background: #fff; }
.cover-date { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border: 1rpx solid rgba(255,255,255,.42); border-radius: 18rpx; background: rgba(255,255,255,.16); text-align: center; }
.cover-month { font-size: 17rpx; font-weight: 700; }
.cover-day { display: block; margin-top: 1rpx; font-size: 51rpx; font-weight: 800; line-height: 1; }
.cover-date-label { margin-top: 5rpx; color: rgba(255,255,255,.76); font-size: 14rpx; letter-spacing: 2rpx; }
.detail-heading { margin-top: 22rpx; }
.detail-title { display: block; color: var(--ink); font-size: 36rpx; font-weight: 800; line-height: 1.28; }
.organizer-row { display: flex; align-items: center; padding: 6rpx 0; margin-top: 13rpx; color: var(--muted); font-size: 20rpx; }
.organizer-row .small-avatar { margin-right: 9rpx; }
.organizer-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.organizer-label { color: var(--muted); font-size: 16rpx; line-height: 1.2; }
.organizer-name { margin-top: 3rpx; overflow: hidden; color: var(--ink-soft); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.official-badge { margin-left: 9rpx; padding: 4rpx 9rpx; border-radius: 7rpx; color: var(--coral); background: var(--coral-soft); font-size: 16rpx; }
.organizer-action { margin-left: 12rpx; color: var(--coral); font-size: 17rpx; }
.event-description { display: block; margin-top: 20rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.62; }
.info-list { padding: 10rpx 20rpx; margin-top: 22rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(84, 56, 22, .05); }
.info-item { display: flex; align-items: center; min-height: 70rpx; padding: 10rpx 0; }
.info-item + .info-item { border-top: 1rpx solid #f4ecdf; }
.info-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 14rpx; border-radius: 12rpx; color: var(--coral); background: var(--coral-soft); font-size: 23rpx; }
.info-copy { min-width: 0; }
.info-label { display: block; color: var(--muted); font-size: 16rpx; line-height: 1.2; }
.info-value { display: block; margin-top: 3rpx; color: var(--ink-soft); font-size: 22rpx; line-height: 1.35; }
.source-block { padding: 18rpx; margin-top: 18rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fffaf1; }
.source-block-head { display: flex; align-items: center; justify-content: space-between; color: var(--ink); font-size: 19rpx; font-weight: 800; }
.source-platform-label { color: var(--coral); font-size: 16rpx; font-weight: 600; }
.source-name { display: block; margin-top: 8rpx; color: var(--ink-soft); font-size: 19rpx; }
.source-summary { display: block; margin-top: 8rpx; color: var(--muted); font-size: 18rpx; line-height: 1.5; }
.source-button { height: 54rpx; padding: 0 16rpx; margin: 12rpx 0 0; border: 1rpx solid #efc59b; border-radius: 10rpx; color: var(--coral); background: #fff; font-size: 18rpx; line-height: 52rpx; }
.source-button::after { border: 0; }
.action-zone { padding: 0 8rpx; margin-top: 24rpx; }
.join-button { width: 100%; height: 76rpx; border-radius: 16rpx; font-size: 25rpx; }
.join-button.joined { background: #4b896f; }
.join-button.full { color: var(--muted); background: #e8e2d8; }
.external-actions { display: flex; gap: 10rpx; }
.external-actions > button { flex: 1; min-width: 0; height: 76rpx; }
.calendar-button { border-color: var(--coral); color: var(--coral); background: var(--coral-soft); font-size: 22rpx; }
.calendar-button.added { color: #377b61; border-color: #b8d9c6; background: #e3f1e8; }
.external-link-button { padding: 0 10rpx; font-size: 22rpx; }
.button-arrow { margin-left: 10rpx; }
.share-note { margin-top: 12rpx; color: var(--muted); font-size: 18rpx; line-height: 1.4; text-align: center; }
.sheet-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(22, 19, 16, .42); }
.link-sheet, .organizer-sheet { width: 100%; padding: 12rpx 32rpx 38rpx; border-radius: 28rpx 28rpx 0 0; background: var(--bg); box-shadow: 0 -12rpx 42rpx rgba(22, 19, 16, .16); }
.organizer-sheet { padding-bottom: 44rpx; }
.sheet-handle { width: 64rpx; height: 6rpx; margin: 0 auto 22rpx; border-radius: 999rpx; background: #d8cdbc; }
.sheet-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.sheet-eyebrow { display: block; color: var(--coral); font-size: 15rpx; font-weight: 800; letter-spacing: 2rpx; }
.sheet-title { display: block; margin-top: 6rpx; color: var(--ink); font-size: 29rpx; font-weight: 800; }
.sheet-close { width: 48rpx; height: 48rpx; padding: 0; color: var(--muted); background: transparent; font-size: 34rpx; line-height: 42rpx; }
.sheet-close::after { border: 0; }
.sheet-copy { display: block; margin-top: 20rpx; color: var(--ink-soft); font-size: 20rpx; line-height: 1.5; }
.link-preview { padding: 16rpx; margin-top: 14rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: #fff; }
.link-preview text { display: block; color: var(--ink-soft); font-size: 20rpx; line-height: 1.5; word-break: break-all; }
.sheet-actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.sheet-actions button { flex: 1; height: 70rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 700; }
.sheet-secondary { border: 1rpx solid var(--line); color: var(--ink-soft); background: #fff; }
.sheet-primary { color: #fff; background: var(--ink); }
.organizer-profile-head { display: flex; align-items: center; margin-top: 24rpx; }
.organizer-avatar { width: 88rpx; height: 88rpx; border-radius: 26rpx; font-size: 32rpx; }
.organizer-profile-copy { flex: 1; min-width: 0; margin-left: 16rpx; }
.organizer-profile-name { display: block; color: var(--ink); font-size: 27rpx; font-weight: 800; }
.organizer-profile-role { display: block; margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }
.organizer-tags { margin-top: 20rpx; }
.organizer-tag { display: inline-block; padding: 6rpx 11rpx; margin: 0 8rpx 8rpx 0; border-radius: 8rpx; color: var(--coral); background: var(--coral-soft); font-size: 17rpx; }
.organizer-bio { display: block; padding: 16rpx; margin-top: 8rpx; border-left: 3rpx solid var(--yellow); color: var(--ink-soft); background: #fff; font-size: 20rpx; line-height: 1.6; }
.member-link-button { width: 100%; height: 70rpx; margin-top: 20rpx; border-radius: 14rpx; font-size: 22rpx; }
.detail-empty { padding-top: 180rpx; }
