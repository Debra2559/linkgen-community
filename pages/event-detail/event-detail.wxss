.event-detail-page { padding-top: 28rpx; padding-bottom: 70rpx; }.event-detail-cover { display: flex; align-items: flex-end; justify-content: space-between; height: 290rpx; padding: 26rpx; border-radius: 28rpx; color: #fff; }.cover-labels { display: flex; flex-direction: column; align-items: flex-start; }.cover-type, .cover-scope { padding: 8rpx 14rpx; border-radius: 9rpx; background: rgba(0,0,0,.16); font-size: 21rpx; }.cover-scope { margin-top: 8rpx; color: var(--ink); background: var(--yellow); font-size: 18rpx; }.cover-date { width: 135rpx; height: 135rpx; padding-top: 20rpx; border-radius: 50%; background: rgba(255,255,255,.17); text-align: center; }.cover-day { display: block; font-size: 58rpx; font-weight: 800; line-height: 1; }.detail-title { margin-top: 28rpx; font-size: 42rpx; }.organizer-row { display: flex; align-items: center; margin-top: 18rpx; color: var(--muted); font-size: 21rpx; }.organizer-row .small-avatar { margin-right: 10rpx; }.official-badge { margin-left: 10rpx; padding: 4rpx 10rpx; border-radius: 7rpx; color: var(--coral); background: var(--coral-soft); font-size: 18rpx; }.event-description { display: block; margin-top: 28rpx; color: var(--ink-soft); font-size: 26rpx; line-height: 1.7; }.info-list { margin-top: 28rpx; padding: 22rpx; border-radius: 20rpx; background: #fff; }.info-list > view { display: flex; align-items: center; padding: 11rpx 0; color: var(--ink-soft); font-size: 23rpx; }.info-icon { width: 48rpx; color: var(--coral); font-size: 27rpx; }.join-button { margin-top: 34rpx; }.join-button.joined { background: #4b896f; }.button-arrow { margin-left: 14rpx; }.share-note { margin-top: 16rpx; color: var(--muted); font-size: 20rpx; text-align: center; }
.detail-empty { padding-top: 180rpx; }
