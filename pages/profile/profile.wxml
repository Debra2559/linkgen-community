<view class="page profile-page">
  <view class="topbar"><view><text class="eyebrow">YOUR LINKGEN</text><text class="section-title page-title">我的</text></view><button class="icon-button">···</button></view>

  <view class="profile-card">
    <view class="card-topline"><text class="card-code">LINKGEN / DIGITAL CARD</text><button class="edit-button" bindtap="goEdit">编辑名片</button></view>
    <view class="profile-top"><view class="avatar profile-avatar" style="background: {{profile.color}}"><image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><text wx:if="{{!profile.avatar}}">{{profile.initials}}</text></view><view class="profile-info"><text class="profile-name">{{profile.name}}</text><text class="profile-role">{{profile.role}}<text wx:if="{{profile.city}}"> · {{profile.city}}</text></text><view class="connect-status"><view class="status-dot"></view><text>正在连接</text></view></view></view>
    <view class="profile-bio">{{profile.bio}}</view>
    <view class="profile-tags"><text wx:for="{{profile.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
    <view class="profile-purpose"><text class="purpose-label">我来这里，是因为</text><text class="purpose-text">{{profile.purpose}}</text></view>
    <view class="card-footer"><text>LINK 01</text><text>OPEN TO GOOD THINGS ↗</text></view>
  </view>

  <view class="stats-row"><view><text class="stat-number">{{stats.posts}}</text><text class="stat-label">发起讨论</text></view><view><text class="stat-number">{{stats.events}}</text><text class="stat-label">参加活动</text></view><view><text class="stat-number">{{stats.likes}}</text><text class="stat-label">获得赞</text></view></view>
  <view class="section-head"><text class="section-title">我的 Link</text><text class="section-caption">更多</text></view>
  <view class="menu-list"><view class="menu-item" bindtap="goFeed"><view class="menu-icon menu-orange">✦</view><view><text class="menu-title">我的动态</text><text class="menu-sub">查看你发起的讨论和回复</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goEvents"><view class="menu-icon menu-yellow">◌</view><view><text class="menu-title">我的活动</text><text class="menu-sub">已报名和提交审核的活动</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goEdit"><view class="menu-icon menu-mint">⌁</view><view><text class="menu-title">我的名片</text><text class="menu-sub">编辑头像、身份和社群标签</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goAdmin"><view class="menu-icon menu-admin">✓</view><view><text class="menu-title">运营管理</text><text class="menu-sub">审核活动、发布官方活动</text></view><text class="menu-arrow">›</text></view></view>
  <view class="profile-footer"><text>LinkGen 01.0</text><text>连接，让好事发生</text></view>
</view>
