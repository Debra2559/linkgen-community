<view class="page profile-page">
  <view class="topbar"><view><text class="eyebrow">YOUR LINKGEN</text><text class="section-title page-title">鎴戠殑</text></view></view>

  <view wx:if="{{!profile.setupComplete}}" class="setup-banner"><view class="setup-mark">01</view><view class="setup-copy"><text class="setup-title">鍏堝仛涓€寮犲睘浜庝綘鐨勫悕鐗?/text><text class="setup-subtitle">琛ュ厖韬唤銆佸煄甯傚拰鍔犲叆鐩殑锛岃鏇村浜鸿璇嗕綘銆?/text></view><button class="setup-button" bindtap="goEdit">寮€濮嬭缃?鈫?/button></view>

  <view class="profile-card" bindtap="previewProfile">
    <view class="card-topline"><text class="card-code">LINKGEN / DIGITAL CARD</text><text class="card-open-mark">鈫?/text></view>
    <view class="profile-top"><view class="avatar profile-avatar" style="background: {{profile.color}}"><image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><text wx:if="{{!profile.avatar}}">{{profile.initials}}</text></view><view class="profile-info"><text class="profile-name">{{profile.name || '浣犵殑鍚嶇墖'}}</text><text class="profile-role">{{profile.role || '韬唤寰呭～鍐?}}<text wx:if="{{profile.city}}"> 路 {{profile.city}}</text></text><view class="connect-status"><view class="status-dot"></view><text>{{profile.setupComplete ? '姝ｅ湪杩炴帴' : '绛夊緟浣犵殑浠嬬粛'}}</text></view></view></view>
    <view class="profile-bio">{{profile.bio || '閫夋嫨榛樿澶村儚涔熷彲浠ワ紝鍏堝啓涓嬬湡瀹炵殑浣犮€?}}</view>
    <view class="profile-tags"><text wx:for="{{profile.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
    <view class="profile-purpose"><text class="purpose-label">鎴戞潵杩欓噷锛屾槸鍥犱负</text><text class="purpose-text">{{profile.purpose || '杩樻病鏈夊～鍐欏姞鍏ョぞ缇ょ殑鐩殑'}}</text></view>
    <view class="card-footer"><text>LINK 01</text><view class="card-edit-link" catchtap="goEdit"><text>缂栬緫</text><text>鈫?/text></view></view>
  </view>

  <view class="stats-row"><view><text class="stat-number">{{stats.posts}}</text><text class="stat-label">鍙戣捣璁ㄨ</text></view><view><text class="stat-number">{{stats.events}}</text><text class="stat-label">鍙傚姞娲诲姩</text></view><view><text class="stat-number">{{stats.likes}}</text><text class="stat-label">鑾峰緱璧?/text></view></view>
  <view class="section-head"><text class="section-title">鎴戠殑 Link</text><text class="section-caption">鏇村</text></view>
  <view class="menu-list"><view class="menu-item" bindtap="goFeed"><view class="menu-icon menu-orange">鉁?/view><view><text class="menu-title">鎴戠殑鍔ㄦ€?/text><text class="menu-sub">鏌ョ湅浣犲彂璧风殑璁ㄨ鍜屽洖澶?/text></view><text class="menu-arrow">鈥?/text></view><view class="menu-item" bindtap="goEvents"><view class="menu-icon menu-yellow">鈼?/view><view><text class="menu-title">鎴戠殑娲诲姩</text><text class="menu-sub">宸叉姤鍚嶅拰鎻愪氦瀹℃牳鐨勬椿鍔?/text></view><text class="menu-arrow">鈥?/text></view><view class="menu-item" bindtap="goEdit"><view class="menu-icon menu-mint">鈱?/view><view><text class="menu-title">鎴戠殑鍚嶇墖</text><text class="menu-sub">缂栬緫澶村儚銆佽韩浠藉拰绀剧兢鏍囩</text></view><text class="menu-arrow">鈥?/text></view><view class="menu-item" bindtap="goAdmin"><view class="menu-icon menu-admin">鉁?/view><view><text class="menu-title">杩愯惀绠＄悊</text><text class="menu-sub">瀹℃牳娲诲姩銆佸彂甯冨畼鏂规椿鍔?/text></view><text class="menu-arrow">鈥?/text></view></view>
  <view class="profile-footer"><text>LinkGen 01.0</text><text>杩炴帴锛岃濂戒簨鍙戠敓</text></view>
  <view class="theme-panel"><view><text class="theme-panel-title">涓婚澶栬</text><text class="theme-panel-subtitle">閫夋嫨浣犲枩娆㈢殑绀惧尯姘涘洿</text></view><view class="theme-options"><button class="theme-option {{themeMode === 'dark' ? 'active' : ''}}" data-theme="dark" bindtap="selectTheme">鏆楄壊</button><button class="theme-option {{themeMode === 'light' ? 'active' : ''}}" data-theme="light" bindtap="selectTheme">浜壊</button></view></view>
</view>
