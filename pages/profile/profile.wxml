<view class="page profile-page {{themeMode === 'light' ? 'theme-light' : ''}}">
  <view class="topbar profile-topbar"><view><text class="eyebrow">YOUR LINKGEN</text><text class="section-title page-title">我的</text></view><view class="theme-switch {{themeMode === 'light' ? 'is-light' : ''}}" role="button" aria-label="切换明暗主题" bindtap="toggleTheme"><text class="theme-icon theme-moon">☾</text><text class="theme-icon theme-sun">☀</text><view class="theme-switch-thumb"></view></view></view>
  <view wx:if="{{!profile.setupComplete}}" class="setup-banner"><view class="setup-mark">01</view><view class="setup-copy"><text class="setup-title">先做一张属于你的名片</text><text class="setup-subtitle">补充身份、城市和加入目的，让更多人认识你。</text></view><button class="setup-button" bindtap="goEdit">开始设置 →</button></view>
  <view class="profile-card" bindtap="previewProfile"><view class="card-topline"><text class="card-code">LINKGEN / DIGITAL CARD</text><text class="card-open-mark">↗</text></view><view class="profile-top"><view class="avatar profile-avatar" style="background: {{profile.color}}"><image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><text wx:if="{{!profile.avatar}}">{{profile.initials}}</text></view><view class="profile-info"><text class="profile-name">{{profile.name || 'Your card'}}</text><text class="profile-role">{{profile.role || 'Role pending'}}<text wx:if="{{profile.city}}"> · {{profile.city}}</text></text><view class="connect-status"><view class="status-dot"></view><text>{{profile.setupComplete ? 'Connected' : 'Introduction pending'}}</text></view></view></view><view class="profile-bio">{{profile.bio || 'Write a little about yourself.'}}</view><view class="profile-tags"><text wx:for="{{profile.tags}}" wx:key="*this" class="tag">#{{item}}</text></view><view class="profile-purpose"><text class="purpose-label">I am here to</text><text class="purpose-text">{{profile.purpose || 'Add your community goal'}}</text></view><view class="card-footer"><text>LINK 01</text><view class="card-edit-link" catchtap="goEdit"><text>Edit</text><text>↗</text></view></view></view>
  <view class="stats-row"><view><text class="stat-number">{{stats.posts}}</text><text class="stat-label">发起讨论</text></view><view><text class="stat-number">{{stats.events}}</text><text class="stat-label">参加活动</text></view><view><text class="stat-number">{{stats.likes}}</text><text class="stat-label">获得赞</text></view></view>
  <view class="section-head"><text class="section-title">我的 Link</text><text class="section-caption">更多</text></view>
  <view class="menu-list"><view class="menu-item" bindtap="goFeed"><view class="menu-icon menu-orange">*</view><view><text class="menu-title">My activity</text><text class="menu-sub">Your posts and replies</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goEvents"><view class="menu-icon menu-yellow">o</view><view><text class="menu-title">My events</text><text class="menu-sub">Registered and submitted events</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goEdit"><view class="menu-icon menu-mint">~</view><view><text class="menu-title">My card</text><text class="menu-sub">Edit avatar, identity and tags</text></view><text class="menu-arrow">›</text></view><view class="menu-item" bindtap="goAdmin"><view class="menu-icon menu-admin">✓</view><view><text class="menu-title">Operations</text><text class="menu-sub">Review and publish events</text></view><text class="menu-arrow">›</text></view></view>
  <view class="profile-footer"><text>LinkGen 01.0</text><text>Connect and grow</text></view>
</view>
