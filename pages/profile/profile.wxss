.profile-page { padding-bottom: 120rpx; }
.page-title { display: block; margin-top: 10rpx; }
.eyebrow { color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.setup-banner { display: flex; align-items: center; min-height: 82rpx; padding: 14rpx 16rpx; margin-bottom: 14rpx; border: 1rpx solid rgba(255,113,59,.22); border-radius: 18rpx; background: var(--coral-soft); }
.setup-mark { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; flex-shrink: 0; margin-right: 12rpx; border-radius: 15rpx; color: #fff; background: var(--coral); font-size: 18rpx; font-weight: 800; }
.setup-copy { flex: 1; min-width: 0; }
.setup-title, .setup-subtitle { display: block; }
.setup-title { color: var(--ink); font-size: 21rpx; font-weight: 800; }
.setup-subtitle { display: -webkit-box; margin-top: 3rpx; overflow: hidden; color: var(--muted); font-size: 17rpx; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.setup-button { min-width: 0; flex-shrink: 0; padding: 8rpx 0 8rpx 10rpx; color: var(--coral); font-size: 18rpx; font-weight: 800; white-space: nowrap; }
.profile-card { padding: 24rpx; border-radius: 30rpx; background: linear-gradient(135deg, #111a35, #172a4b) !important; color: #fff; box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, .28); transition: transform .15s ease, opacity .15s ease; }
.profile-card:active { opacity: .94; transform: scale(.995); }
.card-topline, .card-footer { display: flex; align-items: center; justify-content: space-between; }
.card-code { color: var(--yellow); font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }
.card-open-mark { color: rgba(255,255,255,.52); font-size: 25rpx; }
.profile-top { display: flex; align-items: center; margin-top: 32rpx; }
.profile-avatar { position: relative; width: 116rpx; height: 116rpx; overflow: hidden; border: 4rpx solid rgba(255,255,255,.22); border-radius: 36rpx; font-size: 40rpx; }
.avatar-image { display: block; width: 100%; height: 100%; }
.profile-info { flex: 1; margin-left: 20rpx; }
.profile-name { display: block; color: #fff; font-family: var(--font-display); font-size: 36rpx; font-weight: 800; }
.profile-role { display: block; margin-top: 5rpx; color: rgba(255,255,255,.62); font-size: 21rpx; }
.connect-status { display: flex; align-items: center; margin-top: 12rpx; color: var(--yellow); font-size: 19rpx; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 8rpx; border-radius: 50%; background: #7fd39b; box-shadow: 0 0 0 5rpx rgba(127,211,155,.16); }
.profile-bio { margin-top: 26rpx; color: #f5eee2; font-size: 24rpx; line-height: 1.6; }
.profile-tags { margin-top: 16rpx; }
.profile-tags .tag { color: var(--yellow); background: rgba(255,217,92,.13); }
.profile-purpose { padding: 18rpx 0 0; margin-top: 4rpx; border-top: 1rpx solid rgba(255,255,255,.15); }
.purpose-label { display: block; color: rgba(255,255,255,.5); font-size: 18rpx; }
.purpose-text { display: block; margin-top: 6rpx; color: #fff; font-size: 22rpx; line-height: 1.5; }
.card-footer { padding-top: 24rpx; margin-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.15); color: rgba(255,255,255,.4); font-size: 16rpx; letter-spacing: 1rpx; }
.card-edit-link { display: flex; align-items: center; padding: 6rpx 0 6rpx 14rpx; color: var(--yellow); font-size: 19rpx; font-weight: 800; letter-spacing: 0; }
.card-edit-link text + text { margin-left: 6rpx; font-size: 22rpx; }
.stats-row { display: flex; justify-content: space-around; padding: 26rpx 0 10rpx; text-align: center; }
.stats-row > view { flex: 1; border-right: 1rpx solid var(--line); }
.stats-row > view:last-child { border: 0; }
.stat-number { display: block; color: var(--ink); font-family: var(--font-display); font-size: 38rpx; font-weight: 800; }
.stat-label { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }
.menu-list { overflow: hidden; border-radius: 24rpx; background: var(--card); }
.menu-item { display: flex; align-items: center; padding: 22rpx; border-bottom: 1rpx solid var(--line); }
.menu-item:last-child { border-bottom: 0; }
.menu-icon { width: 62rpx; height: 62rpx; margin-right: 18rpx; border-radius: 20rpx; color: var(--ink); text-align: center; line-height: 62rpx; font-size: 30rpx; }
.menu-orange { background: var(--coral-soft); color: var(--coral); }
.menu-yellow { background: #3a3020; }
.menu-mint { background: var(--mint); }
.menu-admin { background: #292247; color: #b7a4ff; }
.menu-title { display: block; color: var(--ink); font-size: 26rpx; font-weight: 800; }
.menu-sub { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }
.menu-arrow { margin-left: auto; color: var(--muted); font-size: 38rpx; }
.profile-footer { display: flex; justify-content: space-between; margin-top: 42rpx; color: #aeb8b3; font-size: 19rpx; }
.profile-topbar { position: relative; display: flex; align-items: center; width: 100%; }
.profile-topbar > view:first-child { min-width: 0; }
.profile-topbar .theme-switch { position: absolute; top: 42rpx; right: 0; margin: 0; }
.theme-switch { position: relative; display: block; width: 104rpx !important; min-width: 104rpx; max-width: 104rpx; height: 54rpx; flex: 0 0 104rpx; padding: 0; overflow: hidden; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface-input); line-height: 54rpx; }
.theme-icon { position: absolute; z-index: 1; top: 0; width: 50%; height: 52rpx; color: var(--muted); font-size: 23rpx; text-align: center; line-height: 52rpx; }
.theme-moon { left: 0; }
.theme-sun { right: 0; }
.theme-switch-thumb { position: absolute; z-index: 2; top: 5rpx; left: 5rpx; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--coral); box-shadow: 0 4rpx 12rpx rgba(0,0,0,.28); transition: transform .22s ease; }
.theme-switch.is-light .theme-switch-thumb { transform: translateX(51rpx); }
