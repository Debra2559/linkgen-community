/* pages/cart/cart.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
}

.block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

/* 谁点的 */
.quick-names {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.quick-name {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #f2ede9;
  color: #6f6660;
}
.quick-name.on {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}
.name-input {
  background: #faf7f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* 菜品清单 */
.dish-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.dish-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.dish-name {
  flex: 1;
  font-size: 28rpx;
}
.dish-count {
  color: var(--text-sub);
  font-size: 26rpx;
  margin-right: 24rpx;
}
.dish-price {
  font-size: 28rpx;
}
.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  font-size: 28rpx;
}
.total-price {
  font-size: 36rpx;
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  background: #faf7f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(43, 35, 32, 0.06);
}
.submit-total {
  display: flex;
  align-items: baseline;
}
.submit-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}
.submit-price {
  font-size: 40rpx;
}
.submit-btn {
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 64rpx;
}
.submit-btn.disabled {
  opacity: 0.6;
}
.btn-hover {
  opacity: 0.8;
}
