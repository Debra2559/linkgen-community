<view class="page my-posts-page {{themeMode === 'dark' ? 'theme-dark' : ''}}">
  <view class="topbar">
    <view><text class="eyebrow">YOUR ACTIVITY</text><text class="section-title page-title">我的动态</text></view>
    <button class="icon-button" bindtap="goProfile">⌂</button>
  </view>

  <view class="activity-intro">
    <view class="activity-avatar avatar" style="background: {{profile.color}}"><image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><text wx:if="{{!profile.avatar}}">{{profile.initials}}</text></view>
    <view class="activity-copy"><text class="activity-name">{{profile.name || '你的动态'}}</text><text class="activity-note">只展示你在 LinkGen 里留下的内容</text></view>
    <text class="activity-mark">01</text>
  </view>

  <view class="activity-stats">
    <view><text class="activity-stat-number">{{stats.posts}}</text><text class="activity-stat-label">发起讨论</text></view>
    <view><text class="activity-stat-number">{{stats.replies}}</text><text class="activity-stat-label">发表回复</text></view>
    <view><text class="activity-stat-number">{{stats.likes}}</text><text class="activity-stat-label">获得赞</text></view>
  </view>

  <view class="activity-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="activity-tab {{activeTab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="switchTab"><text>{{item.label}}</text><text class="tab-count">{{item.count}}</text></view>
  </view>

  <view wx:if="{{activeTab === 'posts' && visiblePosts.length}}" class="post-list">
    <view wx:for="{{visiblePosts}}" wx:key="id" class="mine-post-card card" data-id="{{item.id}}" bindtap="openPost">
      <view class="mine-post-head"><view><text class="post-status">已发布</text><text class="post-time">{{item.time}}</text></view><text class="mine-post-arrow">↗</text></view>
      <text class="mine-post-title">{{item.title}}</text>
      <text class="mine-post-content">{{item.content}}</text>
      <view wx:if="{{item.attachments && item.attachments.length}}" class="mine-attachments"><view wx:for="{{item.attachments}}" wx:key="id" class="mine-attachment"><image wx:if="{{item.type === 'image'}}" src="{{item.path}}" mode="aspectFill"/><text wx:elif="{{item.type === 'video'}}">▶</text><text wx:else>↗</text></view><text>{{item.attachments.length}} 个附件</text></view>
      <view class="mine-post-tags"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
      <view class="mine-post-footer"><text>♡ {{item.likes}} 获得赞</text><text>◌ {{item.comments}} 条回复</text></view>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'replies' && visibleReplies.length}}" class="reply-list">
    <view wx:for="{{visibleReplies}}" wx:key="id" class="reply-card card" data-id="{{item.postId}}" bindtap="openReply">
      <view class="reply-label"><text>我的回复</text><text>{{item.time}}</text></view>
      <text class="reply-text">{{item.text}}</text>
      <view class="reply-source"><text>回复于</text><text class="reply-source-title">{{item.postTitle}}</text><text class="mine-post-arrow">↗</text></view>
    </view>
  </view>

  <view wx:else class="activity-empty">
    <view class="empty-symbol">✦</view>
    <text class="empty-title">{{activeTab === 'posts' ? '还没有发起过讨论' : '还没有发表过回复'}}</text>
    <text class="empty-copy">{{activeTab === 'posts' ? '把最近的想法发出来，和社区聊聊' : '去社区动态里留下你的第一个观点'}}</text>
    <button wx:if="{{activeTab === 'posts'}}" class="primary-button empty-action" bindtap="goCreatePost">发起第一条讨论 ↗</button>
    <button wx:else class="secondary-button empty-action" bindtap="goProfile">去看看社区动态 ↗</button>
  </view>

  <view wx:if="{{!profile.setupComplete}}" class="profile-reminder"><text class="reminder-dot">!</text><text>先完成名片，发布内容后才能在这里持续积累。</text><button bindtap="goEditProfile">去完善</button></view>
</view>
