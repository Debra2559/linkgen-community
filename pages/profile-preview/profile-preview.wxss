.profile-preview-page {
  padding-top: 26rpx;
  padding-bottom: 80rpx;
}

.preview-nav {
  display: flex;
  align-items: center;
  min-height: 78rpx;
  margin-bottom: 24rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx !important;
  height: 64rpx;
  padding: 0 !important;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  color: var(--ink);
  background: #fff;
  font-size: 42rpx;
  line-height: 1;
}

.back-button::after {
  border: 0;
}

.preview-nav-title {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.page-title {
  display: block;
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.preview-edit-button { display: flex; align-items: center; justify-content: center; width: 112rpx !important; min-width: 112rpx !important; max-width: 112rpx !important; height: 52rpx; padding: 0 !important; border: 1rpx solid var(--coral); border-radius: 14rpx; color: var(--coral); background: var(--coral-soft); font-size: 20rpx; font-weight: 800; }
.preview-edit-button::after { border: 0; }
.preview-edit-button text { margin-left: 6rpx; font-size: 22rpx; }

.card-stage {
  position: relative;
  min-height: 610rpx;
  padding: 26rpx 24rpx 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  color: #fff;
  box-shadow: 0 20rpx 42rpx rgba(22, 19, 16, .16);
}

.stage-grid {
  position: absolute;
  right: -20rpx;
  bottom: 74rpx;
  width: 270rpx;
  height: 270rpx;
  opacity: .18;
  background-image: linear-gradient(90deg, var(--ink) 1rpx, transparent 1rpx), linear-gradient(var(--ink) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
  transform: rotate(12deg);
}

.stage-topline,
.stage-footer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255,255,255,.72);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.stage-identity {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 58rpx;
}

.stage-avatar {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  overflow: hidden;
  border: 7rpx solid rgba(255,255,255,.3);
  border-radius: 46rpx;
  font-size: 52rpx;
  box-shadow: 0 14rpx 26rpx rgba(22,19,16,.16);
}

.avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.stage-person {
  min-width: 0;
  margin-left: 22rpx;
}

.stage-name,
.stage-role,
.stage-intro-label,
.stage-intro-text {
  display: block;
}

.stage-name {
  color: #fff;
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 800;
}

.stage-role {
  margin-top: 8rpx;
  color: rgba(255,255,255,.72);
  font-size: 22rpx;
}

.stage-status {
  display: flex;
  align-items: center;
  margin-top: 17rpx;
  color: var(--yellow);
  font-size: 19rpx;
}

.stage-status-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #7fd39b;
  box-shadow: 0 0 0 5rpx rgba(127,211,155,.16);
}

.stage-intro {
  position: relative;
  padding-top: 24rpx;
  margin-top: 54rpx;
  border-top: 1rpx solid rgba(255,255,255,.24);
}

.stage-intro-label {
  color: rgba(255,255,255,.56);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.stage-intro-text {
  margin-top: 12rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.65;
}

.stage-tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.stage-tag {
  padding: 7rpx 12rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius: 8rpx;
  color: var(--yellow);
  background: rgba(255,217,92,.15);
  font-size: 18rpx;
}

.empty-stage-tag {
  color: rgba(255,255,255,.58);
  background: rgba(255,255,255,.1);
}

.stage-footer {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255,255,255,.18);
  color: rgba(255,255,255,.46);
  font-size: 16rpx;
}

.preview-info-section {
  padding: 22rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  background: var(--yellow);
}

.bio-info {
  background: #fff;
}

.info-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-index {
  color: var(--coral);
  font-family: var(--font-display);
  font-size: 24rpx;
  font-weight: 800;
}

.purpose-copy {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.6;
}

.continue-edit-button {
  margin-top: 24rpx;
}
