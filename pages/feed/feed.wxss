.feed-page { padding-bottom: 130rpx; }
.welcome-block { position: relative; display: flex; justify-content: space-between; min-height: 240rpx; padding: 28rpx 8rpx 12rpx; overflow: hidden; }
.eyebrow { display: block; color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.welcome-title { display: block; margin-top: 18rpx; color: var(--ink); font-family: var(--font-display); font-size: 48rpx; font-weight: 800; line-height: 1.25; letter-spacing: 0; }
.coral-word { color: var(--coral); }
.orbit { position: relative; width: 180rpx; height: 180rpx; flex-shrink: 0; margin-top: 14rpx; margin-right: 14rpx; transform: rotate(5deg); }
.orbit::before { position: absolute; top: 14rpx; right: 11rpx; bottom: 12rpx; left: 8rpx; border-radius: 42rpx 54rpx 36rpx 48rpx; background: var(--yellow); content: ''; transform: rotate(-8deg); }
.orbit::after { position: absolute; top: 24rpx; right: 6rpx; bottom: 18rpx; left: 24rpx; border: 2rpx solid rgba(22,19,16,.45); border-radius: 38rpx 48rpx 34rpx 44rpx; content: ''; transform: rotate(11deg); }
.art-card { position: absolute; z-index: 2; display: flex; align-items: center; padding: 10rpx; border: 2rpx solid rgba(22,19,16,.1); border-radius: 14rpx; box-shadow: 0 10rpx 18rpx rgba(22,19,16,.14); }
.art-card-back { top: 38rpx; right: 8rpx; width: 112rpx; height: 72rpx; background: #fff4d5; transform: rotate(-8deg); }
.art-card-front { bottom: 24rpx; left: 18rpx; width: 128rpx; height: 88rpx; background: var(--card); transform: rotate(7deg); }
.art-avatar { width: 42rpx; height: 42rpx; flex-shrink: 0; overflow: hidden; border: 2rpx solid var(--coral); border-radius: 13rpx; background: var(--coral-soft); }
.art-avatar image { display: block; width: 100%; height: 100%; }
.art-avatar-back { width: 34rpx; height: 34rpx; border-color: #b9c977; border-radius: 11rpx; }
.art-lines { flex: 1; min-width: 0; margin-left: 8rpx; }
.art-line { width: 100%; height: 6rpx; border-radius: 99rpx; background: #d8c8ae; }
.art-line + .art-line { margin-top: 7rpx; }
.art-line-short { width: 68%; }
.art-line-tiny { width: 44%; }
.art-link { position: absolute; right: 9rpx; bottom: 6rpx; color: var(--coral); font-size: 18rpx; font-weight: 800; }
.art-spark { position: absolute; z-index: 3; top: 18rpx; right: 24rpx; color: var(--coral); font-size: 28rpx; transform: rotate(-12deg); }
.pulse-row { display: flex; align-items: center; height: 60rpx; padding: 0 18rpx; border-radius: 16rpx; color: var(--ink-soft); background: var(--mint); font-size: 22rpx; }
.pulse-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #42aa75; box-shadow: 0 0 0 6rpx rgba(66, 170, 117, 0.14); }
.pulse-arrow { margin-left: auto; color: var(--ink); font-size: 28rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.quick-card { min-height: 172rpx; padding: 22rpx; border-radius: 24rpx; }
.quick-coral { background: var(--coral); color: #fff; }
.quick-mint { background: var(--yellow); color: var(--ink); }
.quick-symbol { display: block; font-size: 40rpx; line-height: 1; }
.quick-title { display: block; margin-top: 25rpx; font-size: 29rpx; font-weight: 800; }
.quick-note { display: block; margin-top: 5rpx; font-size: 20rpx; opacity: 0.72; }
.tag-scroll { white-space: nowrap; margin: -4rpx 0 20rpx; }
.topic-chip { display: inline-block; padding: 12rpx 20rpx; margin-right: 10rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: var(--surface-raised); font-size: 22rpx; }
.topic-chip.selected { border-color: var(--coral); color: var(--ink); background: var(--coral); }
.post-card { padding: 26rpx 24rpx 18rpx; margin-bottom: 20rpx; border: 1rpx solid rgba(230, 235, 230, 0.9); }
.post-author .avatar { overflow: hidden; }
.avatar-image { display: block; width: 100%; height: 100%; }
.post-author { display: flex; align-items: center; }
.author-meta { display: flex; flex-direction: column; min-width: 0; margin-left: 16rpx; }
.author-name { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.author-role { margin-top: 3rpx; color: var(--muted); font-size: 20rpx; }
.hot-mark { margin-left: auto; padding: 5rpx 10rpx; border-radius: 7rpx; color: var(--coral); background: var(--coral-soft); font-size: 17rpx; font-weight: 800; letter-spacing: 1rpx; }
.post-title { display: block; margin-top: 24rpx; color: var(--ink); font-size: 31rpx; font-weight: 800; line-height: 1.4; }
.post-content { display: block; margin-top: 10rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.65; }
.post-attachment-summary { display: flex; align-items: center; margin-top: 16rpx; }
.summary-attachment { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 62rpx; margin-right: 8rpx; overflow: hidden; border-radius: 11rpx; color: var(--coral); background: var(--coral-soft); font-size: 23rpx; }
.summary-attachment image { width: 100%; height: 100%; }
.summary-video, .summary-link { display: flex; align-items: center; justify-content: center; flex-direction: column; width: 100%; height: 100%; }
.summary-video text:last-child, .summary-link text:last-child { margin-top: 2rpx; font-size: 15rpx; font-weight: 700; }
.summary-attachment-count { margin-left: 4rpx; color: var(--muted); font-size: 19rpx; }
.post-tags { margin-top: 16rpx; }
.post-tags .tag { margin-bottom: 0; }
.post-actions { display: flex; align-items: center; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.post-action { margin-right: 32rpx; color: var(--muted); font-size: 23rpx; }
.post-action.liked { color: var(--coral); }
.post-more { margin-left: auto; color: var(--muted); font-size: 30rpx; letter-spacing: 3rpx; }
