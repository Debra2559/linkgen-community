.feed-page { padding-bottom: 130rpx; }
.welcome-block { position: relative; display: flex; justify-content: space-between; min-height: 240rpx; padding: 28rpx 8rpx 12rpx; overflow: hidden; }
.eyebrow { display: block; color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.welcome-title { display: block; margin-top: 18rpx; color: var(--ink); font-family: var(--font-display); font-size: 48rpx; font-weight: 800; line-height: 1.25; letter-spacing: 0; }
.coral-word { color: var(--coral); }
.orbit { position: relative; width: 180rpx; height: 180rpx; margin-top: 14rpx; margin-right: 14rpx; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 38rpx; text-align: center; line-height: 180rpx; transform: rotate(12deg); }
.orbit-ring { position: absolute; right: -10rpx; bottom: -8rpx; width: 120rpx; height: 120rpx; border: 2rpx solid var(--ink); border-radius: 50%; opacity: 0.5; }
.pulse-row { display: flex; align-items: center; height: 60rpx; padding: 0 18rpx; border-radius: 16rpx; color: var(--ink-soft); background: var(--mint); font-size: 22rpx; }
.pulse-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #42aa75; box-shadow: 0 0 0 6rpx rgba(66, 170, 117, 0.14); }
.pulse-arrow { margin-left: auto; color: var(--ink); font-size: 28rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.quick-card { min-height: 172rpx; padding: 22rpx; border-radius: 24rpx; }
.quick-coral { background: var(--coral); color: #fff; }
.quick-mint { background: var(--yellow); color: var(--ink); }
.quick-symbol { display: block; font-size: 40rpx; line-height: 1; }
.quick-title { display: block; margin-top: 25rpx; font-size: 29rpx; font-weight: 800; }
.quick-note { display: block; margin-top: 5rpx; font-size: 20rpx; opacity: 0.72; }
.tag-scroll { white-space: nowrap; margin: -4rpx 0 20rpx; }
.topic-chip { display: inline-block; padding: 12rpx 20rpx; margin-right: 10rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: #fff; font-size: 22rpx; }
.topic-chip.selected { border-color: var(--ink); color: #fff; background: var(--ink); }
.post-card { padding: 26rpx 24rpx 18rpx; margin-bottom: 20rpx; border: 1rpx solid rgba(230, 235, 230, 0.9); }
.post-author .avatar { overflow: hidden; }
.avatar-image { display: block; width: 100%; height: 100%; }
.post-author { display: flex; align-items: center; }
.author-meta { display: flex; flex-direction: column; min-width: 0; margin-left: 16rpx; }
.author-name { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.author-role { margin-top: 3rpx; color: var(--muted); font-size: 20rpx; }
.hot-mark { margin-left: auto; padding: 5rpx 10rpx; border-radius: 7rpx; color: var(--coral); background: var(--coral-soft); font-size: 17rpx; font-weight: 800; letter-spacing: 1rpx; }
.post-title { display: block; margin-top: 24rpx; color: var(--ink); font-size: 31rpx; font-weight: 800; line-height: 1.4; }
.post-content { display: block; margin-top: 10rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.65; }
.post-tags { margin-top: 16rpx; }
.post-tags .tag { margin-bottom: 0; }
.post-actions { display: flex; align-items: center; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.post-action { margin-right: 32rpx; color: var(--muted); font-size: 23rpx; }
.post-action.liked { color: var(--coral); }
.post-more { margin-left: auto; color: var(--muted); font-size: 30rpx; letter-spacing: 3rpx; }
