<view class="page feed-page">
  <view class="topbar">
    <view class="brand-lockup"><view class="brand-dot">L</view><text class="brand-name">LinkGen</text><text class="brand-sub">OPEN COMMUNITY</text></view>
    <button class="icon-button" bindtap="goProfile">⌁</button>
  </view>

  <view class="welcome-block">
    <view class="welcome-copy"><text class="eyebrow">MONDAY, AUG 19</text><text class="welcome-title">今天，和谁聊点<br/><text class="coral-word">有意思的？</text></text></view>
    <view class="orbit"><text>✦</text><view class="orbit-ring"></view></view>
  </view>
  <view class="pulse-row"><view class="pulse-dot"></view><text>1,284 位成员正在连接</text><text class="pulse-arrow">↗</text></view>

  <view class="quick-grid">
    <view class="quick-card quick-coral" bindtap="goCreatePost"><text class="quick-symbol">＋</text><text class="quick-title">发起协作</text><text class="quick-note">讨论或活动任务</text></view>
    <view class="quick-card quick-mint" bindtap="goEvents"><text class="quick-symbol">◌</text><text class="quick-title">本周活动</text><text class="quick-note">3 个值得去</text></view>
  </view>

  <view class="section-head"><text class="section-title">社区动态</text><text class="section-caption">按最新排序</text></view>
  <view class="search-box"><text class="search-icon">⌕</text><input class="search-input" placeholder="搜索帖子、话题或成员" value="{{search}}" bindinput="onSearch" /></view>
  <view class="content-switch"><view wx:for="{{contentTypes}}" wx:key="key" class="content-switch-item {{activeContentType === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="onContentType">{{item.label}}</view></view>
  <scroll-view scroll-x class="tag-scroll" show-scrollbar="{{false}}">
    <view wx:for="{{tags}}" wx:key="*this" class="topic-chip {{activeTag === item ? 'selected' : ''}}" data-tag="{{item}}" bindtap="onTag"># {{item}}</view>
  </scroll-view>

  <view wx:if="{{filteredPosts.length}}">
    <view wx:for="{{filteredPosts}}" wx:key="id" class="post-card card" data-id="{{item.id}}" bindtap="openPost">
      <view class="post-author"><view class="avatar" style="background: {{item.color}}"><image wx:if="{{item.avatar}}" class="avatar-image" src="{{item.avatar}}" mode="aspectFill"/><text wx:if="{{!item.avatar}}">{{item.initials}}</text></view><view class="author-meta"><text class="author-name">{{item.author}}</text><text class="author-role">{{item.role}} · {{item.time}}</text></view><text wx:if="{{item.hot}}" class="hot-mark">HOT</text></view>
      <view wx:if="{{item.contentType === 'task'}}" class="task-meta-row"><text class="task-kind">{{item.taskKindLabel}}</text><text class="task-status task-status-{{item.taskStatus}}">{{item.taskStatusLabel}}</text></view>
      <text class="post-title">{{item.title}}</text>
      <text class="post-content">{{item.content}}</text>
      <view wx:if="{{item.contentType === 'task'}}" class="task-facts">
        <view wx:if="{{item.linkedEventTitle}}" class="task-event"><text class="task-fact-label">关联活动</text><text class="task-event-title">{{item.linkedEventTitle}}</text></view>
        <view class="task-numbers"><text>已加入 {{item.participantCount}} / {{item.neededPeople}} 人</text><text wx:if="{{item.deadline}}">截止 {{item.deadline}}</text></view>
        <view class="task-progress"><view class="task-progress-value" style="width: {{item.progressPercent}}%"></view></view>
      </view>
      <view class="post-tags"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
      <view class="post-actions"><button class="post-action {{item.liked ? 'liked' : ''}}" catchtap="toggleLike" data-id="{{item.id}}">♡ {{item.likes}}</button><text class="post-action">◌ {{item.comments}}</text><text class="post-more">···</text></view>
    </view>
  </view>
  <view wx:else class="empty">没有找到相关内容<br/><text class="muted">换个关键词试试</text></view>
  <button class="fab" bindtap="goCreatePost">＋</button>
</view>
