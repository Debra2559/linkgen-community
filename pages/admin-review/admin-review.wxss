: 22rpx; font-weight: 700; }.admin-tabs { display: flex; gap: 12rpx; margin-top: 26rpx; }.admin-tab { padding: 12rpx 20rpx; border-radius: 999rpx; background: #fff; color: var(--muted); font-size: 22rpx; }.admin-tab.active { color: #fff; background: var(--ink); }.review-card { padding: 22rpx; margin-bottom: 18rpx; border: 1rpx solid var(--line); }.review-head { display: flex; justify-content: space-between; }.review-type { color: var(--coral); font-size: 20rpx; font-weight: 800; }.review-source { display: inline-block; padding: 4rpx 8rpx; margin-left: 8rpx; border-radius: 6rpx; color: var(--ink-soft); background: var(--mint); font-size: 16rpx; }.review-status { padding: 5rpx 10rpx; border-radius: 7rpx; font-size: 18rpx; }.review-status.waiting { color: #8e6d20; background: #fff3cb; }.review-status.published { color: #377b61; background: #e3f1e8; }.review-title { display: block; margin-top: 12rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; }.review-preview { display: flex; align-items: stretch; min-height: 128rpx; margin-top: 14rpx; overflow: hidden; border-radius: 14rpx; background: var(--coral-soft); }.review-cover, .review-cover-placeholder { width: 150rpx; flex-shrink: 0; }.review-cover { display: block; height: 128rpx; }.review-cover-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 128rpx; color: var(--coral); background: var(--yellow); font-size: 18rpx; }.review-cover-placeholder text + text { margin-top: 5rpx; color: var(--ink-soft); font-size: 15rpx; }.review-summary-wrap { min-width: 0; padding: 14rpx; }.review-summary-label { display: block; color: var(--coral); font-size: 16rpx; font-weight: 800; }.review-summary { display: -webkit-box; overflow: hidden; margin-top: 6rpx; color: var(--ink-soft); font-size: 18rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.review-meta { display: block; margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }.review-url { d