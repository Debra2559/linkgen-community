.admin-page { padding-bottom: 100rpx; }.page-title { display: block; margin-top: 10rpx; }.eyebrow { color: var(--coral); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }.admin-hero { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; border-radius: 24rpx; background: var(--ink); color: #fff; }.admin-kicker { display: block; color: var(--yellow); font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }.admin-number { display: inline-block; margin-top: 10rpx; font-size: 62rpx; font-weight: 800; line-height: 1; }.admin-note { margin-left: 12rpx; color: #c0d0c9; font-size: 22rpx; }.admin-symbol { width: 100rpx; height: 100rpx; border: 2rpx solid rgba(255,255,255,.3); border-radius: 50%; color: var(--yellow); font-size: 52rpx; text-align: center; line-height: 94rpx; }.agent-panel { padding: 22rpx; margin-top: 22rpx; border: 1rpx solid var(--line); }.agent-head { display: flex; align-items: flex-start; justify-content: space-between; }.agent-kicker { display: block; color: var(--coral); font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.agent-title { display: block; margin-top: 7rpx; color: var(--ink); font-size: 27rpx; font-weight: 800; }.agent-copy { display: block; max-width: 470rpx; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; line-height: 1.4; }.agent-status { flex-shrink: 0; padding: 7rpx 11rpx; border-radius: 8rpx; color: #377b61; background: #e3f1e8; font-size: 18rpx; }.agent-status.running { color: var(--coral); background: var(--coral-soft); }.agent-sources { display: flex; gap: 10rpx; margin-top: 18rpx; }.agent-source { padding: 7rpx 11rpx; border-radius: 8rpx; color: var(--ink-soft); background: var(--mint); font-size: 18rpx; }.agent-meta { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; margin-top: 16rpx; color: var(--muted); font-size: 18rpx; }.agent-run-button { width: 100%; height: 64rpx; margin-top: 18rpx; border-radius: 14rpx; color: #fff; background: var(--ink); font-size: 22rpx; font-weight: 700; }.admin-tabs { display: flex; gap: 12rpx; margin-top: 26rpx; }.admin-tab { padding: 12rpx 20rpx; border-radius: 999rpx; background: #fff; color: var(--muted); font-size: 22rpx; }.admin-tab.active { color: #fff; background: var(--ink); }.review-card { padding: 22rpx; margin-bottom: 18rpx; border: 1rpx solid var(--line); }.review-head { display: flex; justify-content: space-between; }.review-type { color: var(--coral); font-size: 20rpx; font-weight: 800; }.review-source { display: inline-block; padding: 4rpx 8rpx; margin-left: 8rpx; border-radius: 6rpx; color: var(--ink-soft); background: var(--mint); font-size: 16rpx; }.review-status { padding: 5rpx 10rpx; border-radius: 7rpx; font-size: 18rpx; }.review-status.waiting { color: #8e6d20; background: #fff3cb; }.review-status.published { color: #377b61; background: #e3f1e8; }.review-title { display: block; margin-top: 12rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; }.review-meta { display: block; margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }.review-url { display: block; margin-top: 9rpx; overflow: hidden; color: var(--coral); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.review-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }.review-actions button { flex: 1; padding: 12rpx; border-radius: 13rpx; font-size: 22rpx; }.reject-button { color: var(--muted); background: var(--bg); }.approve-button { color: #fff; background: var(--coral); }
